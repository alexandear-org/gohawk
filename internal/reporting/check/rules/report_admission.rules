host
  categoryIncluded!
  Suppressed!
  TestFilePosition!
  ReportingEmitted
  ReportingDelisted
  ReportingUnknownCheck
  ReportingNotSelected
  ReportingSuppressed
  ReportingTestFileSkipped

// Withdrawn identities remain recognized even after leaving the public catalog.
// Unknown identities are errors before selection can hide them. Suppression
// precedes the test-file backstop; neither source query runs for earlier exits.
view Diagnostic = analysis.Diagnostic
  category: Category
  position: Pos

total fn rewrite
  fallback outputs ^ReportingEmitted
  match inputs
    @Admission
    inputs pass (Diagnostic (category: category, position: position)) analyzer declared withdrawn disabled ->
      do
        false <- categoryIncluded withdrawn category
          else
            true -> outputs ^ReportingDelisted
        true <- categoryIncluded declared category
          else
            false -> outputs ^ReportingUnknownCheck
        false <- categoryIncluded disabled category
          else
            true -> outputs ^ReportingNotSelected
        false <- Suppressed pass position analyzer
          else
            true -> outputs ^ReportingSuppressed
        false <- TestFilePosition pass position
          else
            true -> outputs ^ReportingTestFileSkipped
        outputs ^ReportingEmitted
