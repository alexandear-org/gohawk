type Paths = Paths
  Path
  Seen
  Exact

view Evidence = Paths
  path: Path
  seen: Seen

host
  differentPath

signature total = outputs (Paths (Path: "", Seen: false, Exact: false))

@Unnamed
rewrite (inputs paths _ false) = outputs (paths with (Seen: true, Exact: false))

@First
rewrite (inputs paths@(Evidence (seen: false)) path true) =
  outputs (paths with (Path: path, Seen: true, Exact: true))

@Conflict
rewrite (inputs paths@(Evidence (path: previous)) path true)
  | differentPath previous path
  =
  outputs (paths with (Seen: true, Exact: false))

// Matching a path cannot restore exactness lost at an earlier call.
@Same
rewrite (inputs paths _ true) = outputs (paths with (Seen: true))
