signature total = outputs (matching false)

host
  matching = MatchProof
  possible
  samePath
  nonempty
  hasPath! = nonempty
  relativePath!
  mirrored!
  exactReceiver! = ExactReceiver

type ReceiverPath = (pathList, bool)
  tag 1
  KnownPath (path: 0) = true
  MissingPath = false

@Absent
rewrite (inputs _ nil _ _) = outputs (matching false)

// A field cleanup must select the target's exact path, never a sibling field.
// When an exact path is unavailable, derivation supplies possible cleanup only;
// a loop's dynamic element cannot become a must-complete action.
@ExactPath
rewrite (inputs (Exact (local: local, path: path)) receiver _ budget)
  | nonempty path
  =
  case relativePath receiver local budget of
    MissingPath() -> case derives receiver local budget of
      true -> outputs possible()
      false -> outputs (matching false)
    KnownPath (path: actual) -> case hasPath actual of
      true -> outputs (matching (samePath actual path))
      false -> do
        match <- derives receiver local budget
        outputs (matching match)

@ExactValue
rewrite (inputs (Exact (local: local)) receiver _ budget) =
  do
    match <- derives receiver local budget
    outputs (matching match)

@Projection
rewrite (inputs (Projection (local: local)) receiver _ budget) =
  do
    match <- exactReceiver receiver local budget
    outputs (matching match)

// Mirror the caller target's path beneath its supplied owner in the callee.
@Owner
rewrite (inputs mapping@(Owner()) receiver target budget) =
  do
    answer <- mirrored mapping receiver target budget
    outputs answer

@Callback
rewrite (inputs Callback() _ _ _) = outputs (matching false)
