total fn rewrite
  fallback outputs emptyLocal() false
  match inputs
    @Exact
    inputs _ local _ _ value _ true _ ->
      outputs (Exact { local, supplied: value, path: nil }) true
    // A captured projection of the target retains exact completion semantics.
    // A path rooted at the captured cell must keep that cell on both sides;
    // unavailable storage there commits to failure rather than trying containment.
    // An aggregate may carry the target without holding it directly.
    @Related
    inputs context local binding target value matches false invocation ->
      case callback context.Queries value target of
        true -> outputs (Callback { local, supplied: value }) true
        false -> decline
      <|> case derives value target context.Budget of
        true -> outputs (Exact { local, supplied: value, path: nil }) true
        false -> decline
      <|> case pathFrom target value context.Budget of
        true -> outputs (Owner { local, supplied: value }) true
        false -> decline
      <|> do
        true <- pathFrom target binding context.Budget
          else
            false -> decline
        answer <- capturedOwner context local binding invocation
        answer
      <|> case unmatchedContainment context binding target matches of
        true -> outputs (Exact { local, supplied: binding, path: nil }) true
        false -> decline
      <|> outputs emptyLocal() false
