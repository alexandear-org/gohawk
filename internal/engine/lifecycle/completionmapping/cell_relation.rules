signature total fallback outputs (emptyLocal) false;
const deferredExact, deferredContains, deferredUnknown;

rule Exact:
  inputs _ $local _ $target _ deferredExact
  => outputs (Exact local:$local supplied:$target path:nil) true;

rule Contains:
  inputs _ $local $cell _ _ deferredContains
  => outputs (Exact local:$local supplied:$cell path:nil) true;

// A merged cell may hold another value only on paths which never stored this
// target. Require the target to survive on every path through its own store.
rule Other:
  inputs $context $local $cell $target $invocation deferredUnknown
  => do {
       true <- query storedOnPath $context.Queries $cell $target $invocation
         else outputs (emptyLocal) false;
       pure outputs (Exact local:$local supplied:$target path:nil) true;
     };
