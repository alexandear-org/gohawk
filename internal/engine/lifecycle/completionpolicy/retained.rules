signature total = outputs ^CapabilityAbsent nil nil

host
  CapabilityAbsent
  CapabilityClosure
  CapabilityStorage
  CapabilityArguments

view Closure = *ssa.MakeClosure

view Allocation = *ssa.Alloc

view Unary = *ssa.UnOp
  source: X

view Call = *ssa.Call
  common: Call

@Closure
rewrite (inputs closure@(Closure())) = outputs ^CapabilityClosure closure nil

@Cell
rewrite (inputs cell@(Allocation())) = outputs ^CapabilityStorage cell nil

// Retained capability uses the historical storage-source policy for any
// unary leaf. This is not the exact callback binding's load-only contract.
@StoredSource
rewrite (inputs (Unary (source: source))) = outputs ^CapabilityStorage source nil

// A wrapper receiving a callback may retain it without promising to invoke
// it. Keep this general argument scan distinct from exact factory relations.
@Arguments
rewrite (inputs (Call (common: common))) = outputs ^CapabilityArguments nil common.Args
