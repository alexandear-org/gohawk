signature total fallback outputs AggregateOpaque nil;
const AggregateOpaque, AggregateRoot, AggregateFollow, AggregateBounded;

rule Root:
  inputs (Allocation)
  => outputs AggregateRoot nil;

// Explicit bounds, including a constant zero, remain opaque. Only a whole
// slice may preserve this aggregate's callback slots and element numbering.
rule WholeSlice:
  inputs (Slice source:$source low:nil high:nil max:nil)
  => outputs AggregateFollow $source;

rule BoundedSlice:
  inputs (Slice)
  => outputs AggregateBounded nil;
