signature total = outputs ^AggregateOpaque nil

host
  AggregateOpaque
  AggregateRoot
  AggregateFollow
  AggregateBounded

@Root
rewrite (inputs Allocation()) = outputs ^AggregateRoot nil

// Explicit bounds, including a constant zero, remain opaque. Only a whole
// slice may preserve this aggregate's callback slots and element numbering.
@WholeSlice
rewrite (inputs (Slice (source: source, low: nil, high: nil, max: nil))) =
  outputs ^AggregateFollow source

@BoundedSlice
rewrite (inputs Slice()) = outputs ^AggregateBounded nil
