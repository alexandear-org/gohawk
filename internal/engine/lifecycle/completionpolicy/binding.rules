signature total = outputs Opaque()

type Step = BindingStep
  tag Kind
  Opaque = BindingOpaque
  Exact = BindingExact
  Field (field: Field) = BindingField
  Element (element: Element) = BindingElement
  Load (source: Source) = BindingLoad
  Cell (source: Source) = BindingCell

@Exact
rewrite (inputs (Function() | Closure())) = outputs Exact()

@Field
rewrite (inputs (Unary (source: field@(FieldAddress()), op: ^bindingLoadToken))) =
  outputs (Field (field: field))

@Element
rewrite (inputs (Unary (source: element@(IndexAddress()), op: ^bindingLoadToken))) =
  outputs (Element (element: element))

@Load
rewrite (inputs (Unary (source: source, op: ^bindingLoadToken))) = outputs (Load (source: source))

// Stable content is requested at the original observation point by Go.
@Cell
rewrite (inputs cell@(Allocation())) = outputs (Cell (source: cell))
