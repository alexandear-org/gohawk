signature total = outputs nil

view Load = *ssa.UnOp
  op: Op

host
  returnLoadToken
  returnTrue
  returnFalse
  resolveReturn!

// Resolve only compiler-spilled Boolean results. An error's interface box must
// stay intact: a typed nil error is not the nil error result.
type Resolved = (ssa.Value, bool)
  tag 1
  ResolvedValue (value: 0) = true
  Unavailable = false

@BooleanSpill
rewrite (inputs original@(Load (op: ^returnLoadToken)) (^returnTrue | ^returnFalse) budget) =
  case resolveReturn original budget of
    ResolvedValue (value: value) -> outputs value
    Unavailable() -> outputs original

@Original
rewrite (inputs value _ _) = outputs value
