view Load = *ssa.UnOp
  op: Op

host
  returnLoadToken
  returnTrue
  returnFalse
  resolveReturn!

// Resolve only compiler-spilled Boolean results. An error's interface box must
// stay intact: a typed nil error is not the nil error result.
type Resolved = (ssa.Value, bool)
  tag 1
  ResolvedValue (value: 0) = true
  Unavailable = false

total fn rewrite
  fallback outputs nil
  match inputs
    @BooleanSpill
    inputs (Load { op: ^returnLoadToken } as original) (^returnTrue | ^returnFalse) budget ->
      case resolveReturn original budget of
        ResolvedValue { value } -> outputs value
        Unavailable() -> outputs original
    @Original
    inputs value _ _ ->
      outputs value
