type Step = BindingStep
  tag Kind
  Opaque = BindingOpaque
  Exact = BindingExact
  Field (field: Field) = BindingField
  Element (element: Element) = BindingElement
  Load (source: Source) = BindingLoad
  Cell (source: Source) = BindingCell

total fn rewrite
  fallback outputs Opaque()
  match inputs
    @Exact
    inputs (Function() | Closure()) ->
      outputs Exact()
    @Field
    inputs (Unary { source: FieldAddress() as field, op: ^bindingLoadToken }) ->
      outputs (Field { field })
    @Element
    inputs (Unary { source: IndexAddress() as element, op: ^bindingLoadToken }) ->
      outputs (Element { element })
    @Load
    inputs (Unary { source, op: ^bindingLoadToken }) ->
      outputs (Load { source })
    // Stable content is requested at the original observation point by Go.
    @Cell
    inputs (Allocation() as cell) ->
      outputs (Cell { source: cell })
