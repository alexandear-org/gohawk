type Step = BindingStep
  tag Kind
  Opaque = BindingOpaque
  Exact = BindingExact
  Field (field: Field) = BindingField
  Element (element: Element) = BindingElement
  Load (source: Source) = BindingLoad
  Cell (source: Source) = BindingCell

total fn rewrite
  fallback outputs Opaque()
  match inputs
    @Exact
    inputs (Function() | Closure()) ->
      outputs Exact()
    @Field
    inputs (Unary (source: field@(FieldAddress()), op: ^bindingLoadToken)) ->
      outputs (Field (field: field))
    @Element
    inputs (Unary (source: element@(IndexAddress()), op: ^bindingLoadToken)) ->
      outputs (Element (element: element))
    @Load
    inputs (Unary (source: source, op: ^bindingLoadToken)) ->
      outputs (Load (source: source))
    // Stable content is requested at the original observation point by Go.
    @Cell
    inputs cell@(Allocation()) ->
      outputs (Cell (source: cell))
