host
  CapabilityAbsent
  CapabilityClosure
  CapabilityStorage
  CapabilityArguments

view Closure = *ssa.MakeClosure

view Allocation = *ssa.Alloc

view Unary = *ssa.UnOp
  source: X

view Call = *ssa.Call
  common: Call

total fn rewrite
  fallback outputs ^CapabilityAbsent nil nil
  match inputs
    @Closure
    inputs (Closure() as closure) ->
      outputs ^CapabilityClosure closure nil
    @Cell
    inputs (Allocation() as cell) ->
      outputs ^CapabilityStorage cell nil
    // Retained capability uses the historical storage-source policy for any
    // unary leaf. This is not the exact callback binding's load-only contract.
    @StoredSource
    inputs (Unary { source }) ->
      outputs ^CapabilityStorage source nil
    // A wrapper receiving a callback may retain it without promising to invoke
    // it. Keep this general argument scan distinct from exact factory relations.
    @Arguments
    inputs (Call { common }) ->
      outputs ^CapabilityArguments nil common.Args
