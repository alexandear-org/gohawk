host
  returnedValue!
  ResolveReturnValue!
  excludesReturn!
  ReturnResult!

// Exclude contradictory returns before accepting earlier completion. Selecting
// a nonexistent result is uncovered, even when completion was already seen.
type Selected = (ssa.Value, bool)
  tag 1
  SelectedValue (value: 0) = true
  MissingValue = false

total fn rewrite
  fallback outputs Uncovered()
  match inputs
    @Return
    inputs returned condition completed budget ->
      do
        SelectedValue (value: value) <- returnedValue returned condition.Result
          else
            MissingValue() -> outputs Uncovered()
        observed <- ResolveReturnValue value condition.Outcome budget
        false <- excludesReturn condition.Outcome observed
          else
            true -> outputs Irrelevant()
        plan <- ReturnResult observed completed
        outputs plan
