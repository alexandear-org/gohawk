signature total = outputs Absent()

type Origin = CallbackSource
  tag Kind
  Absent = CallbackAbsent
  Exact (closure: Closure) = CallbackExact
  Follow (source: Source) = CallbackFollow
  Storage (source: Source) = CallbackStorage

view Closure = *ssa.MakeClosure

view Call = *ssa.Call
  common: Call

view Unary = *ssa.UnOp
  source: X

view Allocation = *ssa.Alloc

host
  onceSource?

@Closure
rewrite (inputs closure@(Closure()) _) = outputs (Exact (closure: closure))

@DeferredOnce
rewrite (inputs (Call (common: onceSource source)) true) = outputs (Follow (source: source))

// The storage proof retains its observation point and the same child cap.
@CellRead
rewrite (inputs (Unary (source: source)) _) = outputs (Storage (source: source))

@Cell
rewrite (inputs source@(Allocation()) _) = outputs (Storage (source: source))
