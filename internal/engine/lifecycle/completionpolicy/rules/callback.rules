type Origin = CallbackSource
  tag Kind
  Absent = CallbackAbsent
  Exact (closure: Closure) = CallbackExact
  Follow (source: Source) = CallbackFollow
  Storage (source: Source) = CallbackStorage

view Closure = *ssa.MakeClosure

view Call = *ssa.Call
  common: Call

view Unary = *ssa.UnOp
  source: X

view Allocation = *ssa.Alloc

host
  onceSource?

total fn rewrite
  fallback outputs Absent()
  match inputs
    @Closure
    inputs closure@(Closure()) _ ->
      outputs (Exact (closure: closure))
    @DeferredOnce
    inputs (Call (common: onceSource source)) true ->
      outputs (Follow (source: source))
    // The storage proof retains its observation point and the same child cap.
    @CellRead
    inputs (Unary (source: source)) _ ->
      outputs (Storage (source: source))
    @Cell
    inputs source@(Allocation()) _ ->
      outputs (Storage (source: source))
