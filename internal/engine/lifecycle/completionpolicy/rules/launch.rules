type Plan = Callee
  tag Kind
  Absent = CalleeAbsent
  Common (launch: Launch, common: Common, once: AllowOnceFunc) = CalleeCommon
  Callback (launch: Launch, callback: Callback) = CalleeCallback

view Defer = *ssa.Defer

view Go = *ssa.Go

view Call = *ssa.Call
  common: Call

host
  groupCallback?
  cleanupCallback?
  commonOf
  LaunchDeferred
  LaunchCalled
  LaunchStarted

total fn rewrite
  fallback outputs Absent()
  match inputs
    // Only a defer may unwrap OnceFunc: an immediate call could have consumed the
    // wrapper before this completion question. Resolver/body searches remain Go.
    @Deferred
    inputs (Defer() as instruction) ->
      outputs (Common { launch: ^LaunchDeferred, common: commonOf instruction, once: true })
    @Started
    inputs (Go() as instruction) ->
      outputs (Common { launch: ^LaunchStarted, common: commonOf instruction, once: false })
    @WaitGroupGo
    inputs (Call { common: groupCallback callback }) ->
      outputs (Callback { launch: ^LaunchStarted, callback })
    // testing.TB guarantees registered cleanup runs after the test and subtests.
    @Cleanup
    inputs (Call { common: cleanupCallback callback }) ->
      outputs (Callback { launch: ^LaunchDeferred, callback })
    @Called
    inputs (Call() as instruction) ->
      outputs (Common { launch: ^LaunchCalled, common: commonOf instruction, once: false })
