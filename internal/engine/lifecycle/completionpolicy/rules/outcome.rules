host
  evidence
  exhausted
  unknown
  disproven
  unavailable
  budgetExhausted
  completionInCycle
  notFound
  localSSA
  noProvenance

total fn rewrite
  fallback outputs (evidence ^unknown ^unavailable ^noProvenance)
  match inputs
    // A stopped walk cannot establish missing completion. Body availability still
    // supplies local provenance when the allowance has been exhausted.
    @LocalCutoff
    inputs budget true _ _
      when exhausted budget ->
      outputs (evidence ^unknown ^budgetExhausted ^localSSA)
    @UnavailableCutoff
    inputs budget false _ _
      when exhausted budget ->
      outputs (evidence ^unknown ^budgetExhausted ^noProvenance)
    // A helper that releases every element of what it was handed inside a loop,
    // as slackdump's Destroy closes each stored handle, is not covered on every
    // return: the exit edge skips the body and iteration decides the element.
    // This is uncertainty about the element, not a missing completion.
    // https://github.com/rusq/slackdump/blob/f7319928b0993b23d7e9bd8af5e4c69b6f1d2af4/internal/chunk/filemgr.go#L66-L73
    @LoopOnly
    inputs _ true _ true ->
      outputs (evidence ^unknown ^completionInCycle ^localSSA)
    // Unresolved nested work cannot establish missing completion.
    @Incomplete
    inputs _ true true _ ->
      outputs (evidence ^unknown ^unavailable ^localSSA)
    @Missing
    inputs _ true _ _ ->
      outputs (evidence ^disproven ^notFound ^localSSA)
