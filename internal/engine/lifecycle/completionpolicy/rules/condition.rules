type Step = ConditionStep
  tag Kind
  Opaque = ConditionOpaque
  Outcome (value: Value, outcome: Outcome) = ConditionOutcome
  Follow (value: Value, truth: Truth) = ConditionFollow

view Comparison = *ssa.BinOp
  left: X
  right: Y
  op: Op

view Constant = *ssa.Const
  value: Value

host
  conditionEqualToken
  conditionNotEqualToken
  Boolean? = conditionBoolean
  errorNilComparison
  nonconstantOperand
  nilOutcome = nilComparisonOutcome
  operandTruth = comparisonOperandTruth

total fn rewrite
  fallback outputs Opaque()
  match inputs
    // Prefer the existing right constant. Swapping occurs only if that operand
    // is not constant; this differs from the provider's literal-left convention.
    @NilRight
    inputs (Comparison { left: operand, right: Constant() as literal, op: (^conditionEqualToken | ^conditionNotEqualToken) as op }) truth
      when errorNilComparison literal operand ->
      outputs (Outcome { value: operand, outcome: nilOutcome op truth })
    @BooleanRight
    inputs (Comparison { left: operand, right: Constant { value: Boolean literal }, op: (^conditionEqualToken | ^conditionNotEqualToken) as op }) truth ->
      outputs (Follow { value: operand, truth: operandTruth op truth literal })
    @NilLeft
    inputs (Comparison { left: Constant() as literal, right: operand, op: (^conditionEqualToken | ^conditionNotEqualToken) as op }) truth
      when nonconstantOperand operand
      , errorNilComparison literal operand ->
      outputs (Outcome { value: operand, outcome: nilOutcome op truth })
    @BooleanLeft
    inputs (Comparison { left: Constant { value: Boolean literal }, right: operand, op: (^conditionEqualToken | ^conditionNotEqualToken) as op }) truth
      when nonconstantOperand operand ->
      outputs (Follow { value: operand, truth: operandTruth op truth literal })
