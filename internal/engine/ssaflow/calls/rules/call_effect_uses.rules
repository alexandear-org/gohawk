signature total = outputs ^effectUnknown nil

view Debug = *ssa.DebugRef

view FieldAddress = *ssa.FieldAddr

view IndexAddress = *ssa.IndexAddr

view Slice = *ssa.Slice

view ChangedType = *ssa.ChangeType

view Boxed = *ssa.MakeInterface

view ChangedInterface = *ssa.ChangeInterface

view Phi = *ssa.Phi

view Unary = *ssa.UnOp
  op: Op

view Binary = *ssa.BinOp
  op: Op

view Store = *ssa.Store
  address: Addr
  value: Val

view Return = *ssa.Return

view Send = *ssa.Send
  value: X

view MapUpdate = *ssa.MapUpdate
  key: Key
  value: Value

host
  alias = effectAlias
  same = sameEffectValue
  EffectRead
  EffectMutate
  EffectRetain
  effectUnknown
  useLoadToken
  useEqualToken
  useNotEqualToken
  useStored
  useStoredAndMutated
  useSent

@Debug
rewrite (inputs (use: Debug())) = outputs 0 nil

// These forms preserve the supplied address. The Go walk checks every use of
// the resulting alias with the same visited set and counted allowance.
@Alias
rewrite (inputs (use: alias@(FieldAddress() | IndexAddress() | Slice() | ChangedType() | Boxed() | ChangedInterface() | Phi()))) =
  outputs 0 (alias alias)

// Loading reads the slot; subsequent uses of its pointee are a separate query.
@Read
rewrite (inputs (use: (Unary (op: ^useLoadToken) | Binary (op: (^useEqualToken | ^useNotEqualToken))))) =
  outputs ^EffectRead nil

// The new alias may later be loaded and mutated. Retention is observed, but
// absence of other effects cannot be established, even for a local spill.
@StoreBoth
rewrite (inputs (value: value, use: Store (address: address, value: stored)))
  | same address value
  , same stored value
  =
  outputs ^useStoredAndMutated nil

@StoreAddress
rewrite (inputs (value: value, use: Store (address: address)))
  | same address value
  =
  outputs ^EffectMutate nil

@StoreValue
rewrite (inputs (value: value, use: Store (value: stored)))
  | same stored value
  =
  outputs ^useStored nil

@OtherStore
rewrite (inputs (use: Store())) = outputs 0 nil

@Returned
rewrite (inputs (use: Return())) = outputs ^EffectRetain nil

@SentValue
rewrite (inputs (value: value, use: Send (value: sent)))
  | same sent value
  =
  outputs ^useSent nil

@SentChannel
rewrite (inputs (use: Send())) = outputs ^EffectMutate nil

@MapKey
rewrite (inputs (value: value, use: MapUpdate (key: key)))
  | same key value
  =
  outputs ^useStored nil

@MapValue
rewrite (inputs (value: value, use: MapUpdate (value: stored)))
  | same stored value
  =
  outputs ^useStored nil

@MapMutation
rewrite (inputs (use: MapUpdate())) = outputs ^EffectMutate nil
