host
  lockCall?
  unlockCall?
  readLockCall?
  readUnlockCall?
  tryLockCall?

// Recognition supplies only the standard mutation contract. The heap consumer
// independently requires a synchronous direct call and an exact receiver slot.
@Lock
rewrite (lockCall _) = true

@Unlock
rewrite (unlockCall _) = true

@ReadLock
rewrite (readLockCall _) = true

@ReadUnlock
rewrite (readUnlockCall _) = true

@TryLock
rewrite (tryLockCall _) = true
