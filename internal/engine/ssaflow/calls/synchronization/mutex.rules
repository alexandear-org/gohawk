match lockCall, unlockCall, readLockCall, readUnlockCall, tryLockCall;

// Recognition supplies only the standard mutation contract. The heap consumer
// independently requires a synchronous direct call and an exact receiver slot.
rule Lock:
  lockCall _
  => true;

rule Unlock:
  unlockCall _
  => true;

rule ReadLock:
  readLockCall _
  => true;

rule ReadUnlock:
  readUnlockCall _
  => true;

rule TryLock:
  tryLockCall _
  => true;
