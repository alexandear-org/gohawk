host
  lockCall?
  unlockCall?
  readLockCall?
  readUnlockCall?
  waitCall?
  doneCall?
  condCall?
  closeCall?
  addCall?
  integer?

type Primitive = Primitive
  tag Kind
  Lock (resource: Resource)
  Unlock (resource: Resource)
  ReadLock (resource: Resource)
  ReadUnlock (resource: Resource)
  CondWait (resource: Resource)
  Close (resource: Resource)
  GroupDone (resource: Resource)
  GroupWait (resource: Resource)
  GroupAdd (resource: Resource, count: Count, fixed: Fixed)

@ConditionWait
rewrite (condCall receiver) = CondWait receiver

@WriterLock
rewrite (lockCall receiver) = Lock receiver

@WriterUnlock
rewrite (unlockCall receiver) = Unlock receiver

@ReaderLock
rewrite (readLockCall receiver) = ReadLock receiver

@ReaderUnlock
rewrite (readUnlockCall receiver) = ReadUnlock receiver

@ChannelClose
rewrite (closeCall channel) = Close channel

@GroupCompletion
rewrite (doneCall receiver) = GroupDone receiver

@GroupJoin
rewrite (waitCall receiver) = GroupWait receiver

// Preserve the exact integer delta when available. The summary consumer still
// admits only +1; other clients may model different counter transitions.
@KnownGroupCount
rewrite (addCall receiver (integer delta)) = GroupAdd receiver delta true

@UnknownGroupCount
rewrite (addCall receiver _) = GroupAdd receiver 0 false
