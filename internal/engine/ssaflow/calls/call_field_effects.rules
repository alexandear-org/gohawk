signature total = outputs ^effectUnknown nil

view Debug = *ssa.DebugRef

view FieldAddress = *ssa.FieldAddr

view Unary = *ssa.UnOp
  op: Op

view Store = *ssa.Store
  address: Addr

host
  selected = selectedEffectField
  same = sameEffectValue
  EffectRead
  EffectMutate
  EffectRetain
  effectUnknown
  useLoadToken

@Debug
rewrite (inputs (use: Debug())) = outputs 0 nil

// Other fields cannot overwrite this slot. A matching projection is rebased
// and visited by Go; no field access follows a loaded pointer implicitly.
@SelectedField
rewrite (inputs (path: path, use: field@(FieldAddress())))
  | selected path field
  =
  outputs 0 field

@OtherField
rewrite (inputs (use: FieldAddress())) = outputs 0 nil

@Read
rewrite (inputs (use: Unary (op: ^useLoadToken))) = outputs ^EffectRead nil

// A whole-owner write includes this child field. Publication is retention,
// rather than a claim that the stored value establishes ownership transfer.
@Written
rewrite (inputs (path: path, use: Store (address: address)))
  | same address path.Root
  =
  outputs ^EffectMutate nil

@Published
rewrite (inputs (use: Store())) = outputs ^EffectRetain nil
