host
  guardEqualToken
  guardNotEqualToken
  guardLessToken
  guardLessEqualToken
  guardGreaterToken
  guardGreaterEqualToken

view Constant = *ssa.Const
  value: Value

host
  bothNil = guardBothNil
  present = guardConstantPresent
  isEqual = guardIsEqualToken
  equalityToken = guardEqualityToken
  compare = guardLiteralCompare

total fn rewrite
  fallback outputs false false
  match inputs
    // Nil has no go/constant payload. Equality alone decides a pair of nils;
    // other operators remain unavailable and must never reach constant.Compare.
    @NilPair
    inputs op left right
      when bothNil left right ->
      outputs (isEqual op) (equalityToken op)
    @Literals
    inputs op@(^guardEqualToken | ^guardNotEqualToken | ^guardLessToken | ^guardLessEqualToken | ^guardGreaterToken | ^guardGreaterEqualToken) (Constant (value: left)) (Constant (value: right))
      when present left
      , present right ->
      outputs (compare left op right) true
