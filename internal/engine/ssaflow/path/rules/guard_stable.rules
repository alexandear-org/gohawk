signature total = outputs "" false false false

host
  booleanValue
  valueIdentity = guardValueIdentity
  stableEquality
  stableOperand! = stableOperandWithin
  computed! = computedGuard

@Parameter
rewrite (inputs condition@(Parameter()) _)
  | booleanValue condition
  =
  outputs (valueIdentity condition) false true true

// Keep left-before-right short circuiting. A failed operand proof tries the
// ordinary computed-value policy without refunding any search allowance.
@Equality
rewrite (inputs condition@(Comparison (left: left, right: right, op: op@(^guardEqualToken | ^guardNotEqualToken))) budget) =
  do
    true <- stableOperand left budget
      else
        false -> decline
    true <- stableOperand right budget
      else
        false -> decline
    outputs (stableEquality left right) (negated op) true true
  <|> case computed condition budget of
    KnownGuard (identity: identity) -> outputs identity false true true
    UnknownGuard() -> decline
  <|> outputs "" false false false

@Other
rewrite (inputs condition budget) =
  case computed condition budget of
    KnownGuard (identity: identity) -> outputs identity false true true
    UnknownGuard() -> outputs "" false false false
