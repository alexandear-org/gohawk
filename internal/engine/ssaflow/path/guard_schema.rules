view Parameter = *ssa.Parameter

view Allocation = *ssa.Alloc

view Free = *ssa.FreeVar

view Global = *ssa.Global

view Call = *ssa.Call

view Extract = *ssa.Extract

view FieldAddress = *ssa.FieldAddr
  source: X

view Unary = *ssa.UnOp
  source: X
  op: Op

view Comparison = *ssa.BinOp
  left: X
  right: Y
  op: Op

view Constant = *ssa.Const

host
  guardLoadToken
  guardEqualToken
  guardNotEqualToken

type Loaded = (string, bool, bool)
  tag 2
  KnownLoaded (identity: 0, negated: 1) = true
  UnknownLoaded (identity: 0, negated: 1) = false

type Computed = (string, bool)
  tag 1
  KnownGuard (identity: 0) = true
  UnknownGuard (identity: 0) = false

host
  negated = guardNegated
