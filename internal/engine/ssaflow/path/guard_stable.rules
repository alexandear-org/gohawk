signature total fallback outputs "" false false false;
guard booleanValue;
build valueIdentity = guardValueIdentity;
build stableEquality;
query stableOperand = stableOperandWithin;
query computed = computedGuard;

rule Parameter:
  inputs $condition:(Parameter) _
  && booleanValue $condition
  => outputs (valueIdentity $condition) false true true;

// Keep left-before-right short circuiting. A failed operand proof tries the
// ordinary computed-value policy without refunding any search allowance.
rule Equality:
  inputs
    $condition:(Comparison left:$left right:$right op:$op:(or guardEqualToken guardNotEqualToken))
    $budget
  => do {
           true <- query stableOperand $left $budget
             else decline;
           true <- query stableOperand $right $budget
             else decline;
           pure outputs (stableEquality $left $right) (negated $op) true true;
         }
     <|> query computed $condition $budget
           select KnownGuard identity:$identity => outputs $identity false true true
     <|> pure outputs "" false false false;

rule Other:
  inputs $condition $budget
  => query computed $condition $budget {
       KnownGuard identity:$identity => outputs $identity false true true;
       UnknownGuard => outputs "" false false false;
     };
