view changeInterface = *ssa.ChangeInterface
  value: X

view changeType = *ssa.ChangeType
  value: X

view convert = *ssa.Convert
  value: X

view makeInterface = *ssa.MakeInterface
  value: X

view assertion = *ssa.TypeAssert
  value: X
  commaOK: CommaOk

view extract = *ssa.Extract
  tuple: Tuple
  index: Index

host
  allows
  ChangeInterface
  ChangeType
  Convert
  MakeInterface
  TypeAssert

@ChangedInterface
rewrite (changeInterface value)
  | allows ^ChangeInterface
  =
  value

@ChangedType
rewrite (changeType value)
  | allows ^ChangeType
  =
  value

@Converted
rewrite (convert value)
  | allows ^Convert
  =
  value

@Boxed
rewrite (makeInterface value)
  | allows ^MakeInterface
  =
  value

// A comma-ok assertion produces a tuple. Only extraction of element zero
// denotes the asserted object; the success flag is different evidence.
@DirectAssertion
rewrite (assertion value false)
  | allows ^TypeAssert
  =
  value

@ExtractedAssertion
rewrite (extract (assertion value _) 0)
  | allows ^TypeAssert
  =
  value
