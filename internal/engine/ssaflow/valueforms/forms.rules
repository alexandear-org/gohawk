view changeInterface = *ssa.ChangeInterface {
  value: X;
};
view changeType = *ssa.ChangeType {
  value: X;
};
view convert = *ssa.Convert {
  value: X;
};
view makeInterface = *ssa.MakeInterface {
  value: X;
};
view assertion = *ssa.TypeAssert {
  value: X;
  commaOK: CommaOk;
};
view extract = *ssa.Extract {
  tuple: Tuple;
  index: Index;
};
guard allows;
const ChangeInterface, ChangeType, Convert, MakeInterface, TypeAssert;

rule ChangedInterface:
  changeInterface $value
  && allows ChangeInterface
  => $value;

rule ChangedType:
  changeType $value
  && allows ChangeType
  => $value;

rule Converted:
  convert $value
  && allows Convert
  => $value;

rule Boxed:
  makeInterface $value
  && allows MakeInterface
  => $value;

// A comma-ok assertion produces a tuple. Only extraction of element zero
// denotes the asserted object; the success flag is different evidence.
rule DirectAssertion:
  assertion $value false
  && allows TypeAssert
  => $value;

rule ExtractedAssertion:
  extract (assertion $value _) 0
  && allows TypeAssert
  => $value;
