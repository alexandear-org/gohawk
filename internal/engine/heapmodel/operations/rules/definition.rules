type Definition = Definition
  tag Kind
  Ignored
  Alias (value: Value, source: Source)
  FieldAddress (value: Value, source: Source, field: Field)
  FieldLoad (value: Value, source: Source, field: Field)
  IndexAddress (value: Value, source: Source, index: Index)
  IndexLoad (value: Value, source: Source, index: Index)
  Sliced (slice: Slice)
  Load (value: Value, source: Source)
  Opaque (value: Value)

view ArrayPointer = *ssa.SliceToArrayPointer
  source: X

view FieldAddressValue = *ssa.FieldAddr
  source: X
  field: Field

view FieldValue = *ssa.Field
  source: X
  field: Field

view IndexAddressValue = *ssa.IndexAddr
  source: X
  index: Index

view IndexValue = *ssa.Index
  source: X
  index: Index

view SliceValue = *ssa.Slice

view Unary = *ssa.UnOp
  source: X
  op: Op

view Assertion = *ssa.TypeAssert
  source: X
  commaOK: CommaOk

view Map = *ssa.MakeMap

view Channel = *ssa.MakeChan

view SliceAllocation = *ssa.MakeSlice

view Range = *ssa.Range

view Next = *ssa.Next

view Binary = *ssa.BinOp

view MultiConversion = *ssa.MultiConvert

host
  wrapper?
  loadToken

total fn rewrite
  fallback outputs Ignored()
  match inputs
    @ArrayPointer
    inputs (ArrayPointer { source } as value) ->
      outputs (Alias { value, source })
    @Wrapper
    inputs ((wrapper source) as value) ->
      outputs (Alias { value, source })
    @FieldAddress
    inputs (FieldAddressValue { source, field } as value) ->
      outputs (FieldAddress { value, source, field })
    @FieldLoad
    inputs (FieldValue { source, field } as value) ->
      outputs (FieldLoad { value, source, field })
    @IndexAddress
    inputs (IndexAddressValue { source, index } as value) ->
      outputs (IndexAddress { value, source, index })
    @IndexLoad
    inputs (IndexValue { source, index } as value) ->
      outputs (IndexLoad { value, source, index })
    @Slice
    inputs (SliceValue() as slice) ->
      outputs (Sliced { slice })
    @Load
    inputs (Unary { source, op: ^loadToken } as value) ->
      outputs (Load { value, source })
    // A tuple assertion is interpreted by its extraction, never as the object.
    @Assertion
    inputs (Assertion { source, commaOK: false } as value) ->
      outputs (Alias { value, source })
    // These definitions produce opaque storage, without claiming an alias to an
    // operand. Other unsupported values remain unrecorded by this pass.
    @Opaque
    inputs ((Map() | Channel() | SliceAllocation() | Range() | Next() | Binary() | MultiConversion()) as value) ->
      outputs (Opaque { value })
