// Keep whole proofs: a failed completion can carry a cutoff, method or
// provenance that neither a transfer disproof nor a summary may erase.
type Selection = (Proof, bool)
  tag 1
  Available (proof: 0) = true
  Absent = false

total fn rewrite
  fallback outputs (Answer (proof: emptyEvidence(), decided: false))
  match inputs
    @Local
    inputs ^localEvidenceStage evidence request fact summarized ->
      do
        supplied <- suppliedEvidence request
        false <- proven supplied
          else
            true -> outputs (Answer (proof: supplied, decided: true))
        completion <- completion evidence request supplied
        false <- proven completion
          else
            true -> outputs (Answer (proof: completion, decided: true))
        capture <- captured evidence request
        false <- proven capture
          else
            true -> outputs (Answer (proof: capture, decided: true))
        Available (proof: transfer) <- transfer evidence request
          else
            Absent() -> outputs (Answer (proof: completion, decided: true))
        false <- proven transfer
          else
            true -> outputs (Answer (proof: transfer, decided: true))
        false <- abandonedSearch completion
          else
            true -> outputs (Answer (proof: completion, decided: true))
        true <- known transfer
          else
            false -> outputs (Answer (proof: transfer, decided: true))
        true <- known completion
          else
            false -> outputs (Answer (proof: transfer, decided: true))
        outputs (Answer (proof: completion, decided: true))
    // Imported summaries are consulted only after source-visible evidence fails.
    // Projection matching is an opt-in: a selected owner field may be reassigned
    // or exposed independently. Missing summaries remain unknown.
    @ImportedMissing
    inputs ^importedEvidenceStage evidence request fact false ->
      case importedEvidenceRequested request of
        true -> outputs (Answer (proof: unavailableEvidence(), decided: true))
        false -> outputs (Answer (proof: emptyEvidence(), decided: false))
    @Imported
    inputs ^importedEvidenceStage evidence request fact true ->
      case selectedEvidenceRequested request of
        true -> case selected evidence request fact of
          Available (proof: proof) -> outputs (Answer (proof: proof, decided: true))
          Absent() -> decline
        false -> decline
      <|> case receiverStoreEvidence evidence request fact of
        true -> case receiverEscapes request of
          true -> do
            method <- requestedMethod request
            outputs (Answer (proof: importedProof ^reasonReceiverStoreTransfer method, decided: true))
          false -> outputs (Answer (proof: unescapedReceiverEvidence(), decided: true))
        false -> decline
      <|> case importedEvidenceRequested request of
        true -> outputs (Answer (proof: unmatchedImportedEvidence(), decided: true))
        false -> decline
      <|> outputs (Answer (proof: emptyEvidence(), decided: false))
