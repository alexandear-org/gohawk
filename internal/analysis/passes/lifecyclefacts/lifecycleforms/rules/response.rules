view Load = *ssa.UnOp
  op: Op
  source: X

view Field = *ssa.FieldAddr

host
  responseBodyField
  loadToken

total fn rewrite
  fallback outputs nil
  match inputs
    // The exact Response type and its Body declaration supply the storage leaf.
    // This does not establish which response was acquired or whether Body changed.
    @Body
    inputs (Load { op: ^loadToken, source: Field() as field })
      when responseBodyField field ->
      outputs field
