type Use = RetentionUse
  tag Kind
  Ignore = RetentionIgnore
  Store (store: Store) = RetentionStore
  Closure (closure: Closure) = RetentionClosure
  Value (value: Value) = RetentionValue
  Returned (values: Values) = RetentionReturn
  Called (instruction: Instruction) = RetentionCall

view StoreValue = *ssa.Store

view ClosureValue = *ssa.MakeClosure

view Send = *ssa.Send
  value: X

view MapUpdate = *ssa.MapUpdate
  value: Value

view Return = *ssa.Return
  values: Results

view Call = *ssa.Call

view Defer = *ssa.Defer

view Go = *ssa.Go

total fn rewrite
  fallback outputs Ignore()
  match inputs
    @Store
    inputs (StoreValue() as store) _ _ ->
      outputs (Store { store })
    // Capture is not completed ownership transfer. Every-return claims require a
    // separate cleanup registration proof; conditional cleanup cannot settle it.
    @Closure
    inputs (ClosureValue() as closure) _ false ->
      outputs (Closure { closure })
    @Published
    inputs (Send { value } | MapUpdate { value }) _ false ->
      outputs (Value { value })
    // Returning the value is described by returned-owner/view summaries. Strict
    // retention leaves it to those summaries instead of claiming a stored owner.
    @Returned
    inputs (Return { values }) false _ ->
      outputs (Returned { values })
    @Called
    inputs ((Call() | Defer() | Go()) as instruction) _ _ ->
      outputs (Called { instruction })
