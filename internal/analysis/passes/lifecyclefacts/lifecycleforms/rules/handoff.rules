type Use = HandoffUse
  tag Kind
  Reject = HandoffReject
  Ignore = HandoffIgnore
  Follow (alias: Alias) = HandoffFollow
  Return (returned: Return) = HandoffReturn
  Call (call: Call) = HandoffCall

view ReturnValue = *ssa.Return

view Box = *ssa.MakeInterface

view Interface = *ssa.ChangeInterface

view Phi = *ssa.Phi

view Binary = *ssa.BinOp
  op: Op

view CallValue = *ssa.Call

view Debug = *ssa.DebugRef

host
  equalToken
  notEqualToken

total fn rewrite
  fallback outputs Reject()
  match inputs
    @Return
    inputs (ReturnValue() as returned) ->
      outputs (Return { returned })
    // These are the transparent forms shared by fresh and retained results.
    // The host keeps visited state, wrapper depth and result-position agreement.
    @Box
    inputs (Box() as alias) ->
      outputs (Follow { alias })
    @Interface
    inputs (Interface() as alias) ->
      outputs (Follow { alias })
    @Phi
    inputs (Phi() as alias) ->
      outputs (Follow { alias })
    @Comparison
    inputs (Binary { op: (^equalToken | ^notEqualToken) }) ->
      outputs Ignore()
    // A call is only a request: fresh results require cleanup evidence; retained
    // results require an exact wrapper contract and remain within their depth bound.
    @Call
    inputs (CallValue() as call) ->
      outputs (Call { call })
    @Debug
    inputs Debug() ->
      outputs Ignore()
