signature total = outputs Escaped()

type Use = EscapeUse
  tag Kind
  Ignore = EscapeIgnored
  Escaped = EscapeDefinite
  Follow (source: Source) = EscapeFollow
  Store (store: Store) = EscapeStore
  Called (instruction: Instruction) = EscapeCall

view Call = *ssa.Call
  common: Call

view Defer = *ssa.Defer
  common: Call

view Common = ssa.CallCommon
  value: Value

view Return = *ssa.Return

view StoreValue = *ssa.Store
  address: Addr

view Closure = *ssa.MakeClosure

view Unary = *ssa.UnOp

view Debug = *ssa.DebugRef

host
  EscapeAlias?
  sameValue

// A literal only called or deferred in place does not escape. Passing it to a
// different callee still asks that callee's retention proof.
@InPlace
rewrite (inputs value (Call (common: Common (value: called)) | Defer (common: Common (value: called))) _)
  | sameValue value called
  =
  outputs Ignore()

@Called
rewrite (inputs _ instruction@(Call() | Defer()) _) = outputs (Called (instruction: instruction))

@ReturnedStrict
rewrite (inputs _ Return() true) = outputs Ignore()

@ReturnedLoose
rewrite (inputs _ Return() false) = outputs Escaped()

// Converted and projected aggregates escape only when the derived value does.
@Alias
rewrite (inputs _ (EscapeAlias source) _) = outputs (Follow (source: source))

// Storing into a value is not publication of the value itself.
@StoreIntoSelf
rewrite (inputs value (StoreValue (address: address)) _)
  | sameValue value address
  =
  outputs Ignore()

// Local storage must itself escape; a nonlocal destination is an escape.
// The caller retains this storage search and the shared visited set.
@Stored
rewrite (inputs _ store@(StoreValue()) _) = outputs (Store (store: store))

@Captured
rewrite (inputs _ source@(Closure()) _) = outputs (Follow (source: source))

@Ignored
rewrite (inputs _ (Unary() | Debug()) _) = outputs Ignore()
