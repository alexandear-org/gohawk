signature total = outputs false

view FieldAddress = *ssa.FieldAddr
  owner: X

view Store = *ssa.Store
  value: Val
  address: Addr

view Map = *ssa.MakeMap

view SliceAllocation = *ssa.MakeSlice

view IndexAddress = *ssa.IndexAddr

view Slice = *ssa.Slice

view Lookup = *ssa.Lookup

view Assertion = *ssa.TypeAssert

view Extraction = *ssa.Extract
  tuple: Tuple

view Selection = *ssa.Select

view MapUpdate = *ssa.MapUpdate
  key: Key
  value: Value

view Binary = *ssa.BinOp
  op: Op
  left: X
  right: Y

host
  typeOf = node.Type
  primitive = SynchronizationPointer
  elementType = lookupElement
  inert = Value
  address = Address
  elements = Elements
  nilConstant
  equalToken
  notEqualToken

// A primitive's fields are its internal state, never ordinary data.
@Field
rewrite (inputs field@(FieldAddress (owner: owner)))
  | let type = typeOf owner
  , let primitive = primitive type
  , primitive == false
  , address field
  =
  outputs true

// Flag/counter writes cannot satisfy a modeled wait. Reads only choose among
// branches the summary already keeps.
@Write
rewrite (inputs (Store (value: value, address: location)))
  | let type = typeOf value
  , inert type
  , address location
  =
  outputs true

// Empty containers hold no resource. A size panic ends the path before a wait.
@EmptyContainer
rewrite (inputs (Map() | SliceAllocation())) = outputs true

@Indexed
rewrite (inputs index@(IndexAddress()))
  | address index
  =
  outputs true

// Reslicing shares elements and creates no new identity.
@Resliced
rewrite (inputs slice@(Slice()))
  | let type = typeOf slice
  , elements type
  =
  outputs true

// Comma-ok results carry an element plus a Boolean; failed assertions panic.
@Element
rewrite (inputs value@(Lookup() | Assertion()))
  | let type = elementType value
  , inert type
  =
  outputs true

// Select projections belong to the separate dispatch proof.
@SelectProjection
rewrite (inputs (Extraction (tuple: Selection()))) = outputs false

@Projected
rewrite (inputs value@(Extraction()))
  | let type = typeOf value
  , inert type
  =
  outputs true

// Storing resource keys or values would publish them.
@MapWrite
rewrite (inputs (MapUpdate (key: key, value: value)))
  | let keyType = typeOf key
  , inert keyType
  , let valueType = typeOf value
  , inert valueType
  =
  outputs true

// Comparing against nil cannot panic, including interface comparisons.
@LeftNil
rewrite (inputs (Binary (op: (^equalToken | ^notEqualToken), left: left)))
  | nilConstant left
  =
  outputs true

@RightNil
rewrite (inputs (Binary (op: (^equalToken | ^notEqualToken), right: right)))
  | nilConstant right
  =
  outputs true
