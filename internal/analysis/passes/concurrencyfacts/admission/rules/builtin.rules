host
  builtin? = builtinName
  copiedElements
  deletedElement

total fn rewrite
  fallback outputs false
  match inputs
    // Declaration identity is checked by the builtin matcher. Project-defined
    // functions with these names cannot enter the synchronization-free whitelist.
    @Scalar
    inputs (builtin ("len" | "cap" | "min" | "max")) ->
      outputs true
    @Copy
    inputs ((builtin ("append" | "copy")) as common)
      when copiedElements common ->
      outputs true
    @Delete
    inputs ((builtin "delete") as common)
      when deletedElement common ->
      outputs true
