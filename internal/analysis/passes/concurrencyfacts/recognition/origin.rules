signature total fallback outputs OriginUnknown nil nil;
view Call = *ssa.Call {
};
view Extraction = *ssa.Extract {
  tuple: Tuple;
  index: Index;
};
build common = contextCall.Common;
build receiver = ssaflow.CallReceiver;
guard observes = DoneCall;
guard fresh = CancelConstructor;
const OriginUnknown, OriginObserved, OriginFresh;

rule Observed:
  inputs $call:(Call)
  let $common = common $call
  && observes $common
  => outputs OriginObserved nil (receiver $common);

// Constructor result zero is the context, and result one its cancel function.
// The caller still proves that the constructor has an admitted parent.
rule Constructed:
  inputs (Extraction tuple:$call:(Call) index:$index)
  && $index <= 1
  let $common = common $call
  && fresh $common
  => outputs OriginFresh $call nil;
