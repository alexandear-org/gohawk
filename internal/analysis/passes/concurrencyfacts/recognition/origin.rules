signature total = outputs ^OriginUnknown nil nil

view Call = *ssa.Call

view Extraction = *ssa.Extract
  tuple: Tuple
  index: Index

host
  common = contextCall.Common
  receiver = ssaflow.CallReceiver
  observes = DoneCall
  fresh = CancelConstructor
  OriginUnknown
  OriginObserved
  OriginFresh

@Observed
rewrite (inputs call@(Call()))
  | let common = common call
  , observes common
  =
  outputs ^OriginObserved nil (receiver common)

// Constructor result zero is the context, and result one its cancel function.
// The caller still proves that the constructor has an admitted parent.
@Constructed
rewrite (inputs (Extraction (tuple: call@(Call()), index: index)))
  | index <= 1
  , let common = common call
  , fresh common
  =
  outputs ^OriginFresh call nil
