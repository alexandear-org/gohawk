total fn rewrite
  fallback outputs ^AddressBinding nil nil
  match inputs
    @Global
    inputs Global() ->
      outputs ^AddressGlobal nil nil
    // Callee root binding retains the existing unary-source contract. It does
    // not repeat the dereference restriction of canonical fixed-load queries.
    @Capture
    inputs (Unary { source: Capture() as capture }) ->
      outputs ^AddressCapture capture nil
    @Field
    inputs (Unary { source: Field() as field }) ->
      outputs ^AddressField nil field
    @UnsupportedUnary
    inputs Unary() ->
      outputs ^AddressBlocked nil nil
