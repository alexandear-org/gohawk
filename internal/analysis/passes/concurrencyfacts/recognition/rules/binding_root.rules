signature total = outputs ^AddressBinding nil nil

@Global
rewrite (inputs Global()) = outputs ^AddressGlobal nil nil

// Callee root binding retains the existing unary-source contract. It does
// not repeat the dereference restriction of canonical fixed-load queries.
@Capture
rewrite (inputs (Unary (source: capture@(Capture())))) = outputs ^AddressCapture capture nil

@Field
rewrite (inputs (Unary (source: field@(Field())))) = outputs ^AddressField nil field

@UnsupportedUnary
rewrite (inputs Unary()) = outputs ^AddressBlocked nil nil
