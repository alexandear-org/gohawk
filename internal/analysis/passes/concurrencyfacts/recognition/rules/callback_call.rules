view Call = *ssa.Call

host
  common = callbackCall.Common
  invokes = callCommon.IsInvoke
  callee = callCommon.StaticCallee
  input = CallbackInput
  arguments = inertArguments

total fn rewrite
  fallback outputs nil nil false
  match inputs
    // Only synchronous calls form callback holes. Launches and defers keep their
    // existing completion policy in the engine.
    @Method
    inputs call@(Call())
      when let common = common call
      , invokes common
      , input common.Value common.Method
      , arguments common ->
      outputs common.Value common.Method true
    @Function
    inputs call@(Call())
      when let common = common call
      , not (invokes common)
      , (callee common) == nil
      , input common.Value nil
      , arguments common ->
      outputs common.Value nil true
