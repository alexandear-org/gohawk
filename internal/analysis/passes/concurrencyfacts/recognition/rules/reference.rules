signature total = outputs ^ReferenceUnknown nil false

view Call = *ssa.Call

view Parameter = *ssa.Parameter

view Capture = *ssa.FreeVar

view Channel = *ssa.MakeChan

view Allocation = *ssa.Alloc

view Global = *ssa.Global

view Field = *ssa.FieldAddr

host
  typeOf = referenceValue.Type
  common = referenceCall.Common
  canceled = admission.CancellationType
  condition = ConditionConstructor
  synchronization = admission.SynchronizationPointer
  mutex = admission.MutexPointer
  ReferenceUnknown
  ReferenceExact
  ReferenceAddress
  ReferenceRejected

@Condition
rewrite (inputs call@(Call()))
  | let common = common call
  , condition common
  =
  outputs ^ReferenceExact call false

// A rejected call still returns its original value with false availability.
@OtherCall
rewrite (inputs call@(Call())) = outputs ^ReferenceRejected call false

@Symbolic
rewrite (inputs value@(Parameter() | Capture() | Channel())) =
  outputs ^ReferenceExact value (canceled (typeOf value))

@Local
rewrite (inputs value@(Allocation()))
  | synchronization (typeOf value)
  =
  outputs ^ReferenceExact value false

// Mutex addresses name cells, not mutable contents. The engine materializes
// a nonempty embedded path to an existing address before exporting identity.
@Address
rewrite (inputs value@(Global() | Field()))
  | mutex (typeOf value)
  =
  outputs ^ReferenceAddress value false
