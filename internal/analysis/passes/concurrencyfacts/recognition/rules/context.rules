host
  empty = EmptyContext
  fresh = CancelConstructor
  observes = DoneCall
  cancellation = cancelTarget
  parent = parentArgument
  receiver = ssaflow.CallReceiver
  ContextUnknown
  ContextEmpty
  ContextFresh
  ContextObserve
  ContextRequest

total fn rewrite
  fallback outputs ^ContextUnknown nil
  match inputs
    @Missing
    inputs nil ->
      outputs ^ContextUnknown nil
    @NonCanceling
    inputs common
      when empty common ->
      outputs ^ContextEmpty nil
    @Constructor
    inputs common
      when fresh common ->
      outputs ^ContextFresh (parent common)
    @Observation
    inputs common
      when observes common ->
      outputs ^ContextObserve (receiver common)
    // A typed cancellation call is a symbolic request until its exact origin is
    // bound. Context and CancelFunc types alone cannot establish a standard origin.
    @Request
    inputs common
      when cancellation common ->
      outputs ^ContextRequest common.Value
