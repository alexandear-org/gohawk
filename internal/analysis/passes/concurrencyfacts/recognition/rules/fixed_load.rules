total fn rewrite
  fallback outputs ^AddressBlocked nil nil
  match inputs
    @Capture
    inputs (Unary (op: ^dereferenceToken, source: capture@(Capture()))) ->
      outputs ^AddressCapture capture nil
    @Field
    inputs (Unary (op: ^dereferenceToken, source: field@(Field()))) ->
      outputs ^AddressField nil field
