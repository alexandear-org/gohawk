signature total = outputs false

view Parameter = *ssa.Parameter

view Capture = *ssa.FreeVar

host
  typeOf = callbackValue.Type
  canceled = admission.CancellationType
  interface = types.IsInterface
  function = functionType

// Only exact parameters or captures can be supplied by the caller. Loads,
// conversions and phi choices remain opaque; contexts belong to cancellation.
@Method
rewrite (inputs (value: value@(Parameter() | Capture()), method: method))
  | method != nil
  , let type = typeOf value
  , interface type
  , not (canceled type)
  =
  outputs true

@Function
rewrite (inputs (value: value@(Parameter() | Capture()), method: nil))
  | function (typeOf value)
  =
  outputs true
