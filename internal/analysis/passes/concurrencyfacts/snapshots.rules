// Branches may extend these collections. SSA references and already-proven
// path/condition evidence remain immutable borrowed values. Each complete
// schema and freeze policy must account for every future representation field.
record SummarySnapshot = Summary {
  cutoff;
  paths: Paths;
  conditions: Conditions;
  returned: Returned;
  operations: Operations;
  deferred;
  workers: Workers;
  choices: Choices;
  cancellationInputs: CancellationInputs;
  alternativesComplete: AlternativesComplete;
  reason: Reason;
};
record WorkerSnapshot = WorkerSummary {
  operations: Operations;
  alternatives: Alternatives;
  spawn: Spawn;
  site: Site;
  prefix: Prefix;
  branches: Branches;
  alternativeConditions: AlternativeConditions;
  replicated: Replicated;
};
record ChoiceSnapshot = SelectChoice {
  arms: Arms;
  prefix: Prefix;
  site: Site;
  worker: Worker;
};
record ArmSnapshot = SelectArm {
  operation: Operation;
  default: Default;
  stateIndex: StateIndex;
  sequence: Sequence;
  complete: Complete;
};
derive SummarySnapshot {
  freeze cloneEffects = cloneSummarySignature {
    cutoff: borrow;
    paths: borrow;
    conditions: clone_borrow;
    returned: clone_borrow;
    operations: clone_borrow;
    deferred: clone_borrow;
    workers: cloneWorkers;
    choices: cloneChoices;
    cancellationInputs: clone_borrow;
    alternativesComplete: keep;
    reason: keep;
  };
};
derive WorkerSnapshot {
  freeze cloneWorker = cloneWorkerSignature {
    operations: clone_borrow;
    alternatives: cloneOperationAlternatives;
    spawn: borrow;
    site: keep;
    prefix: keep;
    branches: keep;
    alternativeConditions: clone_borrow;
    replicated: keep;
  };
};
derive ChoiceSnapshot {
  freeze cloneChoice = cloneChoiceSignature {
    arms: cloneArms;
    prefix: keep;
    site: keep;
    worker: borrow;
  };
};
derive ArmSnapshot {
  freeze cloneArm = cloneArmSignature {
    operation: borrow;
    default: keep;
    stateIndex: keep;
    sequence: clone_borrow;
    complete: keep;
  };
};
