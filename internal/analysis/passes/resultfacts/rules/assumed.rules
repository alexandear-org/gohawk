host
  Unknown
  AlwaysTrue
  AlwaysFalse

type Assumption = (bool, bool)
  tag 1
  Decided (holds: 0) = true
  Undecided (holds: 0) = false

type Leaf = (Guarantee, bool)
  tag 1
  Resolved (guarantee: 0) = true
  Unavailable (guarantee: 0) = false

host
  assumption! = assumedHolds
  exhausted! = resultBudgetExhausted
  leaf! = Engine.knownLeaf
  booleanGuarantee

total fn rewrite
  fallback outputs ^Unknown false
  match inputs
    // The reaching fold owns wrapper/phi traversal. A decided assumption wins
    // immediately; an undecided cutoff must stop before unconditional inference.
    @AssumedLeaf
    inputs engine value assumed budget ->
      case assumption assumed value budget of
        Decided { holds } -> outputs (booleanGuarantee holds) true
        Undecided() -> do
          false <- exhausted budget
            else
              true -> outputs ^Unknown false
          Resolved { guarantee } <- leaf engine value budget
            else
              Unavailable() -> outputs ^Unknown false
          outputs guarantee true
