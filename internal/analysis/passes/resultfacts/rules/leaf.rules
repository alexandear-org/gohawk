view Constant = *ssa.Const
  literal: Value

view Box = *ssa.MakeInterface
  value: X

view Allocation = *ssa.Alloc

view Channel = *ssa.MakeChan

view Map = *ssa.MakeMap

view Slice = *ssa.MakeSlice

view Function = *ssa.Function

view Closure = *ssa.MakeClosure

host
  Boolean? = resultBooleanLiteral
  Nil = resultNilConstant
  Concrete = resultConcreteBox
  Unknown
  AlwaysNil
  AlwaysNonNil
  AlwaysTrue
  AlwaysFalse

total fn rewrite
  fallback outputs ^Unknown
  match inputs
    @NilConstant
    inputs (Constant() as constant)
      when Nil constant ->
      outputs ^AlwaysNil
    @TrueConstant
    inputs (Constant { literal: Boolean true }) ->
      outputs ^AlwaysTrue
    @FalseConstant
    inputs (Constant { literal: Boolean false }) ->
      outputs ^AlwaysFalse
    // Concrete boxing is nonnil even when its payload is a typed nil. Abstract
    // interface/type-parameter payloads retain Unknown through the total fallback.
    @ConcreteBox
    inputs (Box { value })
      when Concrete value ->
      outputs ^AlwaysNonNil
    @FreshValue
    inputs (Allocation() | Channel() | Map() | Slice() | Function() | Closure()) ->
      outputs ^AlwaysNonNil
