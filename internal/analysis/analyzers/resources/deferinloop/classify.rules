// Invalid host outcomes suppress the report without crediting cleanup.
signature total fallback Unknown reasonNone;
query transferred($instruction) = transfersResource $evidence $instruction $obligation.target;
query opaqueUse($instruction) = opaqueResourceUse $instruction $obligation.target;
query argumentUse($instruction) = resourceUseStatus $evidence $probe $instruction $obligation.target;
query callDetails, cleanupReceiver, cleanupMethod;
const reasonResourceTransferred, reasonResourceCapturedOrStored, reasonExplicitCleanup, reasonNone;
union Call = (bool, *ssa.CallCommon) tag 0 {
  Called = true {
    common: 1;
  };
  NotCalled = false;
};
union Decision = (resourceStatus, deferReason) tag 0 {
  Live = resourceLive {
    reason: 1;
  };
  Settled = resourceSettled {
    reason: 1;
  };
  Unknown = resourceUnknown {
    reason: 1;
  };
};

rule ResourceUse:
  inputs $evidence $probe $instruction $obligation
  => query transferred $instruction {
       true => Settled reasonResourceTransferred;
       false => query callDetails $instruction {
         NotCalled => query opaqueUse $instruction {
           true => Unknown reasonResourceCapturedOrStored;
           false => Live reasonNone;
         };
         Called common:$common => query cleanupReceiver $obligation $common {
           true => query cleanupMethod $obligation $common {
             true => Settled reasonExplicitCleanup;
             false => Live reasonNone;
           };
           false => query $decision = argumentUse $instruction
           decide $decision {
             Live => $decision;
             Settled => $decision;
             Unknown => $decision;
           };
         };
       };
     };
