host
  typedCleanup! = resourceResultCleanup
  responseBody! = responseBodyAcquired
  owned! = acquisitionEvidence.OwnedResult
  ownedMatches! result = ownedResultMatches call target methods result

// The caller already established that this acquisition repeats before the
// defer. Prefer exact result/type evidence, then the response-body contract,
// before asking whether an inferred result owns the target resource.
type Cleanup = (cleanupMethods, bool)
  tag 1
  Known (methods: 0) = true
  Unrecognized = false

type Ownership = (cleanupMethods, int, bool)
  tag 2
  Owned (methods: 0, result: 1) = true
  Unowned = false

total fn rewrite
  fallback outputs nil false
  match inputs
    @Acquisition
    inputs evidence call target ->
      case typedCleanup call target of
        Known (methods: methods) -> outputs methods true
        Unrecognized() -> decline
      <|> case responseBody call target of
        true -> outputs ["Close"] true
        false -> decline
      <|> case owned evidence call of
        Owned (methods: methods, result: result) -> case ownedMatches result of
          true -> outputs methods true
          false -> outputs nil false
        Unowned() -> decline
      <|> outputs nil false
