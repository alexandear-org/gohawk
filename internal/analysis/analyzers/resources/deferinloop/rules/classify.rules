host
  transferred! instruction = transfersResource evidence instruction obligation.target
  opaqueUse! instruction = opaqueResourceUse instruction obligation.target
  argumentUse! instruction = resourceUseStatus evidence probe instruction obligation.target
  callDetails!
  cleanupReceiver!
  cleanupMethod!
  reasonResourceTransferred
  reasonResourceCapturedOrStored
  reasonExplicitCleanup
  reasonNone

type Call = (bool, *ssa.CallCommon)
  tag 0
  Called (common: 1) = true
  NotCalled = false

type Decision = (resourceStatus, deferReason)
  tag 0
  Live (reason: 1) = resourceLive
  Settled (reason: 1) = resourceSettled
  Unknown (reason: 1) = resourceUnknown

// Invalid host outcomes suppress the report without crediting cleanup.
total fn rewrite
  fallback Unknown ^reasonNone
  match inputs
    @ResourceUse
    inputs evidence probe instruction obligation ->
      case transferred instruction of
        true -> Settled ^reasonResourceTransferred
        false -> case callDetails instruction of
          NotCalled() -> case opaqueUse instruction of
            true -> Unknown ^reasonResourceCapturedOrStored
            false -> Live ^reasonNone
          Called { common } -> case cleanupReceiver obligation common of
            true -> case cleanupMethod obligation common of
              true -> Settled ^reasonExplicitCleanup
              false -> Live ^reasonNone
            false -> do
              decision <- argumentUse instruction
              case decision of
                Live() -> decision
                Settled() -> decision
                Unknown() -> decision
