signature total fallback outputs None false;
query exposure = CallQueries.Exposure;
query dispatch = Dispatch;

// A helper can expose the exact resource asynchronously without being launched.
// Preserving an address alone does not establish ownership of its loaded value.
rule Carried:
  inputs $queries $instruction $common true
  => do {
       Disproven <- query exposure $queries $instruction $common
         else {
           Proven reason:$reason => outputs $reason true;
           Unknown reason:$reason => outputs $reason true;
         };
       $answer <- query dispatch $queries $instruction $common true;
       pure $answer;
     };

rule NotCarried:
  inputs $queries $instruction $common false
  => query dispatch $queries $instruction $common false {
       Opaque reason:$reason => outputs $reason true;
       Transparent reason:$reason => outputs $reason false;
     };
