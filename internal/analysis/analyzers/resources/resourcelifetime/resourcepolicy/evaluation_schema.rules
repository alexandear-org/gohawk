type Decision = Decision
  tag State
  Accepted (reason: Reason) = evidenceDisproven
  Unavailable (reason: Reason) = evidenceUnknown
  Reported (reason: Reason, leak: Leak) = evidenceProven

type Error = PairedError
  tag State
  Paired = evidenceProven
  Absent = evidenceDisproven
  ErrorUnavailable = evidenceUnknown

type Correlation = Correlation
  tag State
  Correlated = evidenceProven
  Uncorrelated = evidenceDisproven
  CorrelationUnavailable = evidenceUnknown

type Prepared = Prepared
  tag State
  Ready = evidenceProven
  Declined = evidenceDisproven
  PreparationUnavailable = evidenceUnknown

host
  EvidenceUnavailable
