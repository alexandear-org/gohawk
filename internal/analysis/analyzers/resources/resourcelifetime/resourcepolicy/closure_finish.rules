signature total = outputs ^None false

host
  unreadable! = ClosureQueries.Unreadable
  retains! = ClosureQueries.Retains
  CapturedByStartedLiteral
  CapturedByLiteralCallingUnreadableCallee
  CapturedByRetainingLiteral

// Cleanup in a started literal cannot be ordered against this function's return.
@Started
rewrite (inputs _ Go() _) = outputs ^CapturedByStartedLiteral true

// A called or deferred literal runs in this frame. Cleanup was already queried;
// retention now decides whether the obligation moved. A capture is a cell loaded
// by the body, so exact-argument summaries can miss its cleanup through an
// imported helper. Unreadable-body evidence must precede a retention verdict.
// https://github.com/block/spirit/blob/c554eae/pkg/checksum/single.go#L493-L503
@Local
rewrite (inputs queries _ closure) =
  do
    false <- unreadable queries closure
      else
        true -> outputs ^CapturedByLiteralCallingUnreadableCallee true
    retains <- retains queries closure
    outputs ^CapturedByRetainingLiteral retains
