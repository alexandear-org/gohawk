signature total fallback outputs None false;
query unreadable = ClosureQueries.Unreadable;
query retains = ClosureQueries.Retains;
const CapturedByStartedLiteral, CapturedByLiteralCallingUnreadableCallee, CapturedByRetainingLiteral;

// Cleanup in a started literal cannot be ordered against this function's return.
rule Started:
  inputs _ (Go) _
  => outputs CapturedByStartedLiteral true;

// A called or deferred literal runs in this frame. Cleanup was already queried;
// retention now decides whether the obligation moved. A capture is a cell loaded
// by the body, so exact-argument summaries can miss its cleanup through an
// imported helper. Unreadable-body evidence must precede a retention verdict.
// https://github.com/block/spirit/blob/c554eae/pkg/checksum/single.go#L493-L503
rule Local:
  inputs $queries _ $closure
  => do {
       false <- query unreadable $queries $closure
         else outputs CapturedByLiteralCallingUnreadableCallee true;
       $retains <- query retains $queries $closure;
       pure outputs CapturedByRetainingLiteral $retains;
     };
