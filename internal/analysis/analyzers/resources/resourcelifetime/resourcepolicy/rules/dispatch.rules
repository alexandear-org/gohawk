host
  invokes
  appendBuiltin
  closure! = CallQueries.Closure
  function! = CallQueries.Function
  InterfaceMethod
  Appended

total fn rewrite
  fallback outputs ^None false
  match inputs
    // Being an interface receiver is not consumption. Only arguments carry this
    // resource into the dynamically selected method body.
    @Interface
    inputs _ _ common carried
      when invokes common ->
      outputs ^InterfaceMethod carried
    @Append
    inputs _ _ (Common { value: Builtin() as builtin }) true
      when appendBuiltin builtin ->
      outputs ^Appended true
    // Preserve the inspected reason even when this builtin consumes nothing.
    @Builtin
    inputs _ _ (Common { value: Builtin() }) _ ->
      outputs ^Appended false
    @Closure
    inputs queries instruction (Common { value: Closure() as closure }) carried ->
      case closure queries instruction closure carried of
        Opaque { reason } -> outputs reason true
        Transparent { reason } -> outputs reason false
    @Function
    inputs queries instruction common carried ->
      case function queries instruction common carried of
        Opaque { reason } -> outputs reason true
        Transparent { reason } -> outputs reason false
