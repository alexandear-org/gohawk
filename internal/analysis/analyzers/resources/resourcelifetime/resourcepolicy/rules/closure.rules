host
  deferred! = ClosureQueries.Deferred
  body! = ClosureBody

total fn rewrite
  fallback outputs ^None false
  match inputs
    // A deferred literal observes the cell at return, which can differ from its
    // registration-time value. Reuse prior-registration uncertainty before treating
    // an unresolved release as a transparent call.
    // https://github.com/anton48/vk-turn-proxy-ios/blob/001caf2ae24ecd07b021d7ca7b14a98a006bff65/third_party/speedtest-go/speedtest/server.go#L262-L285
    @Deferred
    inputs queries (Defer() as instruction) closure carried ->
      do
        Disproven() <- deferred queries instruction
          else
            Proven { reason } -> outputs reason true
            Unknown { reason } -> outputs reason true
        answer <- body queries instruction closure carried
        answer
    @Other
    inputs queries instruction closure carried ->
      do
        answer <- body queries instruction closure carried
        answer
