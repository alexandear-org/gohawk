host
  storage! = InstructionQueries.Storage
  unknownStorage! = Storage.Unknown
  wrapper! = InstructionQueries.Wrapper
  collectionOwner!
  StoredOnCollectionOwner

total fn rewrite
  fallback outputs ^None false
  match inputs
    // An owner selected from a collection may already be retained elsewhere.
    // A local collection does not prove its elements are local owners.
    // https://github.com/cloudflare/artifact-fs/blob/2b87a48691ef4ae82d391b7bbe4976c06c7fadf7/internal/fusefs/fuse_unix.go#L256-L287
    @Stored
    inputs queries store ->
      do
        storage <- storage queries store
        false <- unknownStorage storage
          else
            true -> outputs storage.Reason true
        false <- collectionOwner store storage
          else
            true -> outputs ^StoredOnCollectionOwner true
        Disproven { reason } <- wrapper queries store
          else
            Proven { reason } -> outputs reason true
            Unknown { reason } -> outputs reason true
        outputs reason false
