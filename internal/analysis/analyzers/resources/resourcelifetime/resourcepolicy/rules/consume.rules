host
  possible
  returned! = InstructionQueries.Returned
  stored! = StoreConsumption
  send! = Send
  payload! = InstructionQueries.Payload
  select! = InstructionQueries.Select
  call! = InstructionQueries.Call
  common = ssaflow.InstructionCall
  StoredOnCollectionOwner
  StoredInMap

total fn rewrite
  fallback outputs ^None false
  match inputs
    @Returned
    inputs queries return@(Return()) ->
      do
        proof <- returned queries return
        outputs proof.Reason (possible proof)
    @Stored
    inputs queries store@(Store()) ->
      do
        answer <- stored queries store
        answer
    @Sent
    inputs queries instruction@(Send (value: value)) ->
      do
        answer <- send queries value instruction
        answer
    @Mapped
    inputs queries (Map (value: value)) ->
      do
        answer <- payload queries value ^StoredInMap
        answer
    @Selected
    inputs queries select@(Select()) ->
      do
        answer <- select queries select
        answer
    @Called
    inputs queries instruction@(Call() | Defer() | Go())
      when let common = common instruction ->
      do
        answer <- call queries instruction common
        answer
