host
  memory! = EvaluationQueries.MemoryWriter
  begin! = EvaluationQueries.Begin
  acquire! = Acquire
  MemoryWriter

total fn rewrite
  fallback outputs (Unavailable (reason: ^EvidenceUnavailable))
  match inputs
    // This is a policy exclusion, not proof that a compressor was finalized.
    // Keep it before candidate evidence, tracing, allowances and all flow queries.
    @Candidate
    inputs queries ->
      do
        false <- memory queries
          else
            true -> outputs (Accepted (reason: ^MemoryWriter))
        candidate <- begin queries
        decision <- acquire candidate
        outputs decision
