host
  escape! = FunctionQueries.Escape
  aggregate! = FunctionQueries.Aggregate
  publication! = FunctionQueries.Publication
  unmodeled! = FunctionQueries.Unmodeled
  NestedInTransferredArgument
  UnsummarizedCallee

total fn rewrite
  fallback outputs ^None false
  match inputs
    @NotCarried
    inputs _ _ _ false ->
      outputs ^None false
    // An aggregate owner may outlive a retaining helper even with no result. A
    // read-only helper keeps the obligation live.
    // https://github.com/goshs-labs/goshs/blob/c65ca19696e87cd5ec2206b2a488c5f5f5b621db/smbserver/session.go#L135-L137
    // Otherwise a nested resource crosses this boundary only when the call's own
    // result is published. Discarding that result transfers nothing.
    // https://github.com/google/oss-rebuild/blob/9ce0528dd68bf209b52cc9fdc90bd63742cbb3a0/pkg/sysgraph/sgstorage/loader.go#L173-L179
    @Carried
    inputs queries instruction common true ->
      do
        Disproven() <- escape queries instruction common
          else
            Proven { reason } -> outputs reason true
            Unknown { reason } -> outputs reason true
        Disproven() <- aggregate queries common
          else
            Unknown { reason } -> outputs reason true
            Proven() -> do
              Disproven() <- publication queries instruction
                else
                  Unknown { reason } -> outputs reason true
                  Proven() -> outputs ^NestedInTransferredArgument true
              unmodeled <- unmodeled queries instruction common
              outputs ^UnsummarizedCallee unmodeled
        unmodeled <- unmodeled queries instruction common
        outputs ^UnsummarizedCallee unmodeled
