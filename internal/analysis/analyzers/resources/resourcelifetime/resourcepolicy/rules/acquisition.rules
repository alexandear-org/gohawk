host
  error! = AcquisitionQueries.Error
  errorUnknown = PairedError.Unknown
  boundary! = AcquisitionQueries.Boundary
  canceled! = AcquisitionQueries.Canceled
  asserted! = AcquisitionQueries.Asserted
  optional! = AcquisitionQueries.Optional
  optionalUnknown = Correlation.Unknown
  prepare! = Initialization.Prepare
  prepareUnknown = Prepared.Unknown
  finalize! = Finalize
  CanceledAcquisition
  ReleaseProven

total fn rewrite
  fallback outputs (Unavailable { reason: ^EvidenceUnavailable })
  match inputs
    // A paired error restricts the edges on which acquisition creates an obligation.
    // A shortened lookup stops before missing evidence can activate a failed edge.
    // Optional correlation may bind a resource phi only after a complete proof;
    // initialization carries that exact packet into owner discovery and flow.
    @Acquisition
    inputs queries ->
      do
        error <- error queries
        false <- errorUnknown error
          else
            true -> outputs (Unavailable { reason: error.Reason })
        boundary <- boundary queries
        true <- boundary == ^None
          else
            false -> outputs (Unavailable { reason: boundary })
        Disproven() <- canceled queries
          else
            Unknown { reason } -> outputs (Unavailable { reason })
            Proven() -> outputs (Accepted { reason: ^CanceledAcquisition })
        Disproven() <- asserted queries error.Value
          else
            Unknown { reason } -> outputs (Unavailable { reason })
            Proven() -> outputs (Accepted { reason: ^ReleaseProven })
        optional <- optional queries error.Value
        false <- optionalUnknown optional
          else
            true -> outputs (Unavailable { reason: optional.Reason })
        prepared <- prepare optional.Initialize
        false <- prepareUnknown prepared
          else
            true -> outputs (Unavailable { reason: prepared.Reason })
        decision <- finalize prepared.Queries error.Value
        outputs decision
