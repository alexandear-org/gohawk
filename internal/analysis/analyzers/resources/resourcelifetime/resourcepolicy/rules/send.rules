signature total = outputs ^None false

host
  handoff! = InstructionQueries.Handoff
  unknown! = Evidence.Unknown
  payload! = InstructionQueries.Payload
  SentToChannel

@Sent
rewrite (inputs queries value instruction) =
  do
    proof <- handoff queries value instruction
    false <- unknown proof
      else
        true -> outputs proof.Reason true
    answer <- payload queries value ^SentToChannel
    answer
