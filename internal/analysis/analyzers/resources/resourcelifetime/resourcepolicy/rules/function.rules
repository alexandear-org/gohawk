host
  dynamic
  chain! = FunctionQueries.Chain
  tail! = FunctionTail
  DynamicCallee

total fn rewrite
  fallback outputs ^None false
  match inputs
    @Dynamic
    inputs _ _ common carried
      when dynamic common ->
      outputs ^DynamicCallee carried
    // A retained constructor chain may carry the resource directly or through an
    // aggregate. Query it before rejecting a call without directly carried args.
    @Named
    inputs queries instruction common carried ->
      do
        Disproven() <- chain queries instruction common
          else
            Proven (reason: reason) -> outputs reason true
            Unknown (reason: reason) -> outputs reason true
        answer <- tail queries instruction common carried
        answer
