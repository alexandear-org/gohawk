signature total fallback outputs None false;
query unknown = Evidence.Unknown;
query proven = Evidence.Proven;
query carried = CallQueries.Carried;
query callback = CallQueries.Callback;
query after = AfterCallback;

rule Absent:
  inputs _ _ nil
  => outputs None false;

// Retained callbacks are queried even when ordinary arguments do not carry the
// resource. Unknown carried evidence stops before any callback query.
rule Call:
  inputs $queries $instruction $common
  => do {
       $proof <- query carried $queries $common;
       false <- query unknown $proof
         else outputs $proof.Reason true;
       $carried <- query proven $proof;
       Disproven <- query callback $queries $instruction $common
         else {
           Proven reason:$reason => outputs $reason true;
           Unknown reason:$reason => outputs $reason true;
         };
       $answer <- query after $queries $instruction $common $carried;
       pure $answer;
     };
