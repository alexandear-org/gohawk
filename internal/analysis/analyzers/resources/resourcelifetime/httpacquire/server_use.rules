signature total = outputs false

host
  hasReferrers
  serverClientCall
  serverClose
  loads! = urlFieldLoads
  client! = onlyClientGetUsesWithin

// URL is field zero. Config/Listener access cannot retain endpoint identity.
@URL
rewrite (inputs field@(FieldAddress (field: 0)) budget)
  | hasReferrers field
  =
  case loads field budget of
    true -> outputs true
    false -> outputs false

@Client
rewrite (inputs client@(Call()) budget)
  | serverClientCall client
  =
  case client client budget of
    true -> outputs true
    false -> outputs false

@Close
rewrite (inputs instruction _)
  | serverClose instruction
  =
  outputs true
