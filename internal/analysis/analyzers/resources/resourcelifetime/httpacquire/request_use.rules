signature total = outputs false

host
  requestDo
  requestRebindUse
  requestHeader
  follow! = headRequestQuery.followUses
  header! = headerUsesAreEditsWithin

@Debug
rewrite (inputs _ _ _ Debug()) = outputs true

@Do
rewrite (inputs _ _ request call@(Call()))
  | requestDo call request
  =
  outputs true

@Rebind
rewrite (inputs query walk request call@(Call()))
  | requestRebindUse call request
  =
  case follow query walk call of
    true -> outputs true
    false -> outputs false

// Header edits preserve Method; opaque map consumers remain unavailable.
@Header
rewrite (inputs query _ _ field@(FieldAddress()))
  | requestHeader field
  =
  case header field query.budget of
    true -> outputs true
    false -> outputs false
