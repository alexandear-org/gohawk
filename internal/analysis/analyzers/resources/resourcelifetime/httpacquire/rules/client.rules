host
  defaultClientValue
  direct! = onlyHTTPDoUsesWithin
  unmodified! = DefaultClientUnmodified
  cell! = zeroClientCellWithin
  result = carriedProof

total fn rewrite
  fallback outputs (Unknown (reason: ^None))
  match inputs
    @Allocation
    inputs client@(Allocation()) _ budget ->
      case direct client budget of
        true -> outputs (result true budget)
        false -> outputs (result false budget)
    // The default root's Do-only allowance must not enter strict helper memos.
    @Default
    inputs client@(Unary (source: source, op: ^loadToken)) function budget
      when defaultClientValue source ->
      case direct client budget of
        false -> outputs (result false budget)
        true -> do
          proof <- unmodified function budget
          case proof of
            Unknown() -> outputs proof
            Disproven() -> outputs proof
            Proven() -> outputs proof
    @LocalCell
    inputs (Unary (source: cell@(Allocation()), op: ^loadToken)) _ budget ->
      case cell cell budget of
        true -> outputs (result true budget)
        false -> outputs (result false budget)
    @Other
    inputs _ _ budget ->
      outputs (result false budget)
