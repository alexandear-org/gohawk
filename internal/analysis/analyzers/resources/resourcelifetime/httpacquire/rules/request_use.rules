host
  requestDo
  requestRebindUse
  requestHeader
  follow! = headRequestQuery.followUses
  header! = headerUsesAreEditsWithin

total fn rewrite
  fallback outputs false
  match inputs
    @Debug
    inputs _ _ _ Debug() ->
      outputs true
    @Do
    inputs _ _ request call@(Call())
      when requestDo call request ->
      outputs true
    @Rebind
    inputs query walk request call@(Call())
      when requestRebindUse call request ->
      case follow query walk call of
        true -> outputs true
        false -> outputs false
    // Header edits preserve Method; opaque map consumers remain unavailable.
    @Header
    inputs query _ _ field@(FieldAddress())
      when requestHeader field ->
      case header field query.budget of
        true -> outputs true
        false -> outputs false
