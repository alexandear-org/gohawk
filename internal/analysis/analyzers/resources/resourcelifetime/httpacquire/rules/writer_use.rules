signature total = outputs false

host
  cookieCall
  writerHeaderCall
  writerStatusCall
  header! = benignHTTPHeaders
  helper! = Effects.writerHelper
  status = writerStatus

@InterfaceChange
rewrite (inputs _ InterfaceChange() _ _) = outputs true

@Cookie
rewrite (inputs _ call@(Call()) _ _)
  | cookieCall call
  =
  outputs true

@Header
rewrite (inputs _ call@(Call()) _ budget)
  | writerHeaderCall call
  =
  case header call budget of
    true -> outputs true
    false -> outputs false

// Nonredirect final statuses preserve empty framing; a failed status check is
// terminal, so it never falls through to visible-helper inference.
@Status
rewrite (inputs _ call@(Call()) _ _)
  | writerStatusCall call
  =
  outputs (status call)

@Helper
rewrite (inputs effects call@(Call()) writer budget) =
  case helper effects call writer budget of
    true -> outputs true
    false -> outputs false
