host
  cookieCall
  writerHeaderCall
  writerStatusCall
  header! = benignHTTPHeaders
  helper! = Effects.writerHelper
  status = writerStatus

total fn rewrite
  fallback outputs false
  match inputs
    @InterfaceChange
    inputs _ InterfaceChange() _ _ ->
      outputs true
    @Cookie
    inputs _ (Call() as call) _ _
      when cookieCall call ->
      outputs true
    @Header
    inputs _ (Call() as call) _ budget
      when writerHeaderCall call ->
      case header call budget of
        true -> outputs true
        false -> outputs false
    // Nonredirect final statuses preserve empty framing; a failed status check is
    // terminal, so it never falls through to visible-helper inference.
    @Status
    inputs _ (Call() as call) _ _
      when writerStatusCall call ->
      outputs (status call)
    @Helper
    inputs effects (Call() as call) writer budget ->
      case helper effects call writer budget of
        true -> outputs true
        false -> outputs false
