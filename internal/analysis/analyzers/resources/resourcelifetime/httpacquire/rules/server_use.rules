host
  hasReferrers
  serverClientCall
  serverClose
  loads! = urlFieldLoads
  client! = onlyClientGetUsesWithin

total fn rewrite
  fallback outputs false
  match inputs
    // URL is field zero. Config/Listener access cannot retain endpoint identity.
    @URL
    inputs field@(FieldAddress (field: 0)) budget
      when hasReferrers field ->
      case loads field budget of
        true -> outputs true
        false -> outputs false
    @Client
    inputs client@(Call()) budget
      when serverClientCall client ->
      case client client budget of
        true -> outputs true
        false -> outputs false
    @Close
    inputs instruction _
      when serverClose instruction ->
      outputs true
