host
  localURL?
  spend!
  server! = localServer
  client! = matchesClient
  handler! = localHandler
  framing! = localEffects

type Server = (*ssa.Call, bool)
  tag 1
  FoundServer (server: 0) = true
  NoServer = false

type Handler = (*ssa.Function, bool)
  tag 1
  FoundHandler (function: 0) = true
  NoHandler = false

total fn rewrite
  fallback outputs (Unknown (reason: ^None))
  match inputs
    @Endpoint
    inputs call@(localURL url) budget ->
      do
        true <- spend budget
          else
            false -> outputs (Unknown (reason: ^BudgetExhausted))
        FoundServer (server: server) <- server url budget
          else
            NoServer() -> outputs (Disproven (reason: ^ServerIdentityUnavailable))
        true <- client call server
          else
            false -> outputs (Disproven (reason: ^ServerIdentityUnavailable))
        FoundHandler (function: handler) <- handler server budget
          else
            NoHandler() -> outputs (Disproven (reason: ^HandlerUnavailable))
        Proven (reason: reason) <- framing call handler budget
          else
            Unknown (reason: unknownReason) -> outputs (Unknown (reason: unknownReason))
            Disproven (reason: disprovenReason) -> outputs (Disproven (reason: disprovenReason))
        outputs (Proven (reason: reason))
