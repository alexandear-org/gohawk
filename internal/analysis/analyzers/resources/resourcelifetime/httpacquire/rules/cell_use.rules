host
  sameValue
  stored! = onlyStoredIntoWithin
  direct! = onlyHTTPDoUsesWithin
  closure! = closureLoadsCellForDoWithin

total fn rewrite
  fallback outputs false false
  match inputs
    @Debug
    inputs Debug() _ stored _ ->
      outputs true stored
    // Exactly one store of one unmodified fresh allocation establishes zero state.
    @Store
    inputs store@(Store (address: address, value: fresh@(Allocation()))) cell false budget
      when sameValue address cell ->
      case stored fresh store budget of
        true -> outputs true true
        false -> outputs false false
    @Load
    inputs load@(Unary (op: ^loadToken)) _ stored budget ->
      case direct load budget of
        true -> outputs true stored
        false -> outputs false false
    @Captured
    inputs closure@(Closure()) cell stored budget ->
      case closure closure cell budget of
        true -> outputs true stored
        false -> outputs false false
