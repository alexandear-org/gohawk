signature total fallback outputs (Unknown reason:None);
match headDo;
query constructed = headConstructedWithin;
query unchanged = headRequestWithin;
query client = headClient;

// Non-HEAD origins stay silent. Mutation is explained only after the exact
// constructor chain has been recognized, preserving the old query order.
rule Head:
  inputs $call:(headDo $client $request) $budget
  => do {
       true <- query constructed $request $budget
         else outputs (Unknown reason:None);
       true <- query unchanged $request $budget
         else outputs (Disproven reason:HeadRequestModified);
       Proven <- query client $client $call $budget
         else {
           Unknown reason:$reason => outputs (Unknown reason:$reason);
           Disproven => outputs (Disproven reason:HeadClientNotUnconfigured);
         };
       pure outputs (Unknown reason:HeadAcquisition);
     };
