signature total = outputs (Unknown (reason: ^None))

host
  headDo?
  constructed! = headConstructedWithin
  unchanged! = headRequestWithin
  client! = headClient

// Non-HEAD origins stay silent. Mutation is explained only after the exact
// constructor chain has been recognized, preserving the old query order.
@Head
rewrite (inputs call@(headDo client request) budget) =
  do
    true <- constructed request budget
      else
        false -> outputs (Unknown (reason: ^None))
    true <- unchanged request budget
      else
        false -> outputs (Disproven (reason: ^HeadRequestModified))
    Proven() <- client client call budget
      else
        Unknown (reason: reason) -> outputs (Unknown (reason: reason))
        Disproven() -> outputs (Disproven (reason: ^HeadClientNotUnconfigured))
    outputs (Unknown (reason: ^HeadAcquisition))
