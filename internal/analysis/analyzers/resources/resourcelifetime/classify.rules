signature total = outputs ^actionUnknown ^resourceReasonEvidenceUnavailable

host
  collection! instruction = localCollection.label analysis.collection instruction
  guarded! = resourceAnalysis.resultGuardedLabel
  compression! = resourceAnalysis.compressionOutputAbandoned
  parent! = resourceAnalysis.parentCleanup
  canceled! instruction = cancelsTransactionContext analysis.acquisition instruction
  release! = resourceAnalysis.releasesResource
  ambiguous! = resourceAnalysis.ambiguousCleanup
  paired! = resourceAnalysis.pairedCleanup
  loop! = resourceAnalysis.loopCleanup
  opaque! = resourceAnalysis.opaqueConsumption

type Recognized = (resourceAction, resourceLifetimeReason, bool)
  tag 2
  Recognized (action: 0, reason: 1) = true
  Unrecognized = false

type Evidence = resourceProof
  tag State
  Proven (reason: Reason) = resourceProven
  Disproven = resourceDisproven
  Unknown (reason: Reason) = resourceUnknown

type Release = (resourceAction, resourceLifetimeReason)
  tag 0
  Untouched = actionNone
  Settled (reason: 1) = actionSettled
  Uncertain (reason: 1) = actionUnknown

type Opacity = (resourceLifetimeReason, bool)
  tag 1
  Opaque (reason: 0) = true
  Transparent = false

host
  actionNone
  actionSettled
  actionUnknown
  resourceProven
  resourceDisproven
  resourceUnknown
  resourceReasonEvidenceUnavailable
  resourceReasonCompressionOutputMayBeAbandoned
  resourceReasonTransactionContextCanceled
  resourceReasonUntouched

// Collection and guarded-result labels are authoritative even when they say
// untouched. Later evidence queries must not run once one of them recognizes.
// Parent cleanup and possible releases remain uncertainty, never settlement.
@Instruction
rewrite (inputs analysis instruction) =
  case collection instruction of
    Recognized (action: action, reason: reason) -> outputs action reason
    Unrecognized() -> decline
  <|> case guarded analysis instruction of
    Recognized (action: action, reason: reason) -> outputs action reason
    Unrecognized() -> decline
  <|> case compression analysis instruction of
    true -> outputs ^actionUnknown ^resourceReasonCompressionOutputMayBeAbandoned
    false -> decline
  <|> case parent analysis instruction of
    Proven (reason: reason) -> outputs ^actionUnknown reason
    Unknown (reason: reason) -> outputs ^actionUnknown reason
    Disproven() -> decline
  <|> case canceled instruction of
    true -> outputs ^actionUnknown ^resourceReasonTransactionContextCanceled
    false -> decline
  <|> do
    label <- release analysis instruction
    case label of
      Settled() -> label
      Uncertain() -> label
      Untouched() -> decline
  <|> case ambiguous analysis instruction of
    Proven (reason: reason) -> outputs ^actionUnknown reason
    Unknown (reason: reason) -> outputs ^actionUnknown reason
    Disproven() -> decline
  <|> case paired analysis instruction of
    Proven (reason: reason) -> outputs ^actionUnknown reason
    Unknown (reason: reason) -> outputs ^actionUnknown reason
    Disproven() -> decline
  <|> case loop analysis instruction of
    Proven (reason: reason) -> outputs ^actionUnknown reason
    Unknown (reason: reason) -> outputs ^actionUnknown reason
    Disproven() -> decline
  <|> case opaque analysis instruction of
    Opaque (reason: reason) -> outputs ^actionUnknown reason
    Transparent() -> decline
  <|> outputs ^actionNone ^resourceReasonUntouched
