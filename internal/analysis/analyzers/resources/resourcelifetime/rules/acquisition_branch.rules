view Evidence = resourceProof
  state: State

host
  branchProof
  testifyResult
  flowResult
  unknownBranch
  testify! = testifyNoErrorSuccessBranch
  available! = branchAvailable
  flow! = resourceSuccessEdge
  resourceUnknown
  resourceProven

type Guard = (bool, bool)
  tag 1
  GuardFound (success: 0) = true
  NoGuard = false

total fn rewrite
  fallback outputs (branchProof unknownBranch() false) false
  match inputs
    @Unavailable
    inputs (Evidence { state: ^resourceUnknown } as proof) _ _ _ _ _ ->
      outputs (branchProof proof false) false
    // A true documented nonnil-error guard excludes acquisition on this edge.
    @FailedAcquisition
    inputs (Evidence { state: ^resourceProven } as proof) true _ _ _ _ ->
      outputs (branchProof proof false) true
    @OtherBranch
    inputs _ _ branch successor error budget ->
      do
        GuardFound { success } <- testify branch successor error budget
          else
            NoGuard() -> decline
        true <- available budget
          else
            false -> decline
        outputs (testifyResult success budget) success
      <|> case flow branch successor error budget of
        GuardFound { success: flowSuccess } -> outputs (flowResult flowSuccess true budget) false
        NoGuard() -> decline
      <|> outputs (flowResult false false budget) false
