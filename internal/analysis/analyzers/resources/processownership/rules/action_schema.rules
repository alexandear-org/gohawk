type State = processUseEvidence
  tag State
  Completed = decisionProven
  Incomplete = decisionDisproven
  Indeterminate = decisionUnknown

type Settlement = (bool, proofs.EvidenceState)
  tag 0
  Settled = true
  Unsettled (fallback: 1) = false

host
  decisionProven
  decisionDisproven
  decisionUnknown
