host
  commandUse! = proveCommandUseAfterStart
  entryLifetime!
  decisionUnknown
  decisionDisproven
  decisionProven
  reasonAmbiguousWaitOwnership
  reasonWaitOwnershipProven
  reasonCommandUseCutoff
  reasonUnusedCommandOwnershipUnknown
  reasonProgramLifetimeOwnershipUnknown
  reasonUnownedReturn

type Decision = processDecision
  state
  reason

type Use = processUseEvidence
  tag State
  Used = decisionProven
  Unused = decisionDisproven
  Uncertain = decisionUnknown

total fn rewrite
  fallback outputs (Decision (state: ^decisionUnknown, reason: ^reasonCommandUseCutoff))
  match inputs
    @AmbiguousSettlement
    inputs (witness: nil, unknown: true) ->
      outputs (Decision (state: ^decisionUnknown, reason: ^reasonAmbiguousWaitOwnership))
    @Settled
    inputs (witness: nil) ->
      outputs (Decision (state: ^decisionDisproven, reason: ^reasonWaitOwnershipProven))
    // Fire-and-forget alone cannot distinguish an intentional browser or daemon
    // launch from a defect. Retiring the detached audit must not broaden missing-wait
    // to report those same uncertain launches. Only an uncovered return asks use.
    // A one-time start in the executable's entry may be owned until program
    // exit. This declines the report; it does not credit Kill as Wait or assert
    // that parent exit terminates the child. Repeated starts, referenced entries
    // and reusable callees remain ordinary wait obligations.
    // https://github.com/coder/acp-go-sdk/blob/0845a3bb9eddda5bfc22a94dd3598c90cb842451/example/agent/main.go#L401-L423
    @UncoveredReturn
    inputs (start: start, command: command, budget: budget) ->
      case commandUse start command budget of
        Uncertain() -> outputs (Decision (state: ^decisionUnknown, reason: ^reasonCommandUseCutoff))
        Unused() -> outputs (Decision (state: ^decisionUnknown, reason: ^reasonUnusedCommandOwnershipUnknown))
        Used() -> case entryLifetime start of
          true -> outputs (Decision (state: ^decisionUnknown, reason: ^reasonProgramLifetimeOwnershipUnknown))
          false -> outputs (Decision (state: ^decisionProven, reason: ^reasonUnownedReturn))
