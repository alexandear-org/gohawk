host
  waits = waitsForCommand
  released = releasedProcess
  ownership! = commandProof.commandOwnership

total fn rewrite
  fallback outputs false ^decisionUnknown
  match inputs
    // Direct witnesses precede the lifecycle query. Their existing identity checks
    // retain their own allowances and do not spend the prepared completion budget.
    @Settlement
    inputs proof instruction command budget ->
      if waits instruction command || released instruction command
        then outputs true ^decisionDisproven
        else do
          answer <- ownership proof instruction command budget
          answer
