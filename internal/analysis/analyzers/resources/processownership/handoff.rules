signature total fallback outputs (missingHandoff);
query handoffCall, handoffWait, mergedWaitReceiver, handoffBody, handoffStarted;
query handoffReturns, handoffCompletion, provePossibleCallbackCapture, handoffArguments;
build missingHandoff, uncertainHandoff, mergedHandoff;
union Call = (*ssa.CallCommon, bool) tag 1 {
  Called = true {
    common: 0;
  };
  NotCalled = false;
};
// A callback supplied to an opaque runner may own Wait. A nonreturning worker
// with a positive Wait witness also remains uncertain: every-return completion
// deliberately excludes it. Neither case establishes exact reaping.
// https://github.com/la5nta/pat/blob/2e6a8d14baf0268f4e2aa4d01784a54ca935cf52/internal/prehook/prehook.go#L109-L114
union Body = (*ssa.Function, bool) tag 1 {
  Visible = true {
    function: 0;
  };
  Opaque = false;
};

// A phi may select the started command without proving exact identity.
// Keep possible reaping unknown instead of crediting a guaranteed Wait.
// https://github.com/raskrebs/sonar/blob/9c963b8447d6ca08dd4a3c0bc6c0bf27527cd793/internal/runs/runs_test.go#L117-L130
// Imported and unresolved runners can retain the same callback whether
// called or launched. Ask its value before scanning supplied arguments.
// https://github.com/unstablebuild/rune/blob/3e2165f8983280542c985947378dfa740a397d03/internal/workspace/file_scheme.go#L458-L467
rule Handoff:
  inputs $instruction $command $budget
  => do {
       Called common:$common <- query handoffCall $instruction
         else {
           NotCalled => outputs (missingHandoff);
         };
       false <- query handoffWait $common
         else query mergedWaitReceiver $common $command {
                true => outputs (mergedHandoff);
                false => outputs (missingHandoff);
              };
       Visible function:$function <- query handoffBody $common
         else {
           Opaque => do {
             $capture <- query provePossibleCallbackCapture $common.Value $command $budget;
             true <- query known $capture
               else outputs $capture;
             $argument <- query handoffArguments $common $command $budget;
             pure outputs $argument;
           };
         };
       true <- query handoffStarted $instruction
         else outputs (missingHandoff);
       $returns <- query handoffReturns $function $budget;
       false <- query cutoff $returns
         else outputs $returns;
       false <- query proven $returns
         else outputs (missingHandoff);
       $completion <- query handoffCompletion $instruction $command $budget;
       true <- query proven $completion
         else query cutoff $completion {
                true => outputs (uncertainHandoff $completion);
                false => outputs (missingHandoff);
              };
       pure outputs (uncertainHandoff $completion);
     };
