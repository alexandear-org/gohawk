union State = processUseEvidence tag State {
  Completed = decisionProven;
  Incomplete = decisionDisproven;
  Indeterminate = decisionUnknown;
};
union Settlement = (bool, proofs.EvidenceState) tag 0 {
  Settled = true;
  Unsettled = false {
    fallback: 1;
  };
};
const decisionProven, decisionDisproven, decisionUnknown;
