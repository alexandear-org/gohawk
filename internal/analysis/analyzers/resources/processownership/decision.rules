query commandUse, entryLifetime;
const decisionUnknown, decisionDisproven, decisionProven;
const reasonAmbiguousWaitOwnership, reasonWaitOwnershipProven, reasonCommandUseCutoff;
const reasonUnusedCommandOwnershipUnknown, reasonProgramLifetimeOwnershipUnknown, reasonUnownedReturn;
record Request = processReturnRequest {
  start;
  command;
  witness;
  unknown;
  budget;
};
record Decision = processDecision {
  state;
  reason;
};
union Use = processUseEvidence tag state {
  Used = decisionProven {};
  Unused = decisionDisproven {};
  Uncertain = decisionUnknown {};
};
union Entry = processEntryEvidence tag owned {
  ProgramLifetime = entryOwned {};
  OrdinaryLifetime = entryOrdinary {};
};

rule AmbiguousSettlement:
  Request witness:nil unknown:true
  => Decision state:decisionUnknown reason:reasonAmbiguousWaitOwnership;

rule Settled:
  Request witness:nil
  => Decision state:decisionDisproven reason:reasonWaitOwnershipProven;

// Fire-and-forget alone cannot distinguish an intentional browser or daemon
// launch from a defect. Retiring the detached audit must not broaden missing-wait
// to report those same uncertain launches. Only an uncovered return asks use.
// A one-time start in the executable's entry may be owned until program
// exit. This declines the report; it does not credit Kill as Wait or assert
// that parent exit terminates the child. Repeated starts, referenced entries
// and reusable callees remain ordinary wait obligations.
// https://github.com/coder/acp-go-sdk/blob/0845a3bb9eddda5bfc22a94dd3598c90cb842451/example/agent/main.go#L401-L423
rule UncoveredReturn:
  $request
  => query $use = commandUse $request
     decide $use {
       Uncertain => Decision state:decisionUnknown reason:reasonCommandUseCutoff;
       Unused => Decision state:decisionUnknown reason:reasonUnusedCommandOwnershipUnknown;
       Used => query $entry = entryLifetime $request
       decide $entry {
         ProgramLifetime => Decision state:decisionUnknown reason:reasonProgramLifetimeOwnershipUnknown;
         OrdinaryLifetime => Decision state:decisionProven reason:reasonUnownedReturn;
       };
     };
