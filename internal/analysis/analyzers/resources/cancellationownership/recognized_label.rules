signature total = outputs (Opaque ^reasonLabelHelperUndecided) true

host
  direct! = cancellationClassifier.recognizedDirectAction
  call! = cancellationClassifier.recognizedCallAction

@Recognized
rewrite (inputs instruction classifier common) =
  case direct classifier instruction common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> do
      result <- call classifier instruction common
      case result of
        Decided() -> result
        Unrecognized() -> result
