host
  callsValue! instruction = lifecycle.DeferredClosureCallsValue instruction classifier.cancel
  invokes! instruction = lifecycle.DeferredClosureInvokesArgumentOnEveryReturn instruction classifier.cancel
  captures! instruction = deferredClosureCaptures instruction classifier.cancel
  resolved! instruction = deferredClosureUseIsLocallyResolved instruction classifier.cancel classifier.observer

total fn rewrite
  fallback outputs (Opaque ^reasonLabelDeferredClosure) true
  match inputs
    // Captured callbacks and helper chains are deliberately ambiguous. These broad
    // traversals establish possible participation, not which callback runs on every
    // path. Each search runs only after the preceding question fails to establish it.
    @DeferredUse
    inputs instruction classifier ->
      case callsValue instruction of
        true -> outputs (Opaque ^reasonLabelDeferredClosure) true
        false -> decline
      <|> case invokes instruction of
        true -> outputs (Opaque ^reasonLabelDeferredClosure) true
        false -> decline
      <|> case captures instruction of
        true -> outputs (Opaque ^reasonLabelDeferredClosure) true
        false -> decline
      <|> case resolved instruction of
        true -> outputs (NoAction ^reasonCancellationNone) true
        false -> decline
      <|> outputs (NoAction ^reasonCancellationNone) false
