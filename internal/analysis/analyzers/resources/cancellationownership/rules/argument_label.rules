view Launch = *ssa.Go

host
  completion! = cancellationClassifier.argumentCompletion
  summaryInvokes! = cancellationClassifier.summaryInvokes
  mayInvoke! instruction = lifecycle.CallInvokesArgumentOnEveryReturn instruction classifier.cancel
  returnsCleanup! instruction = lifecycle.CallReturnsDeferredCleanup instruction classifier.cancel

// A launched helper is a possible handoff, even if its invocation of cancel is
// conditional. It cannot establish synchronous release.
// https://github.com/infercrane/infercrane/blob/93a43cebe36e01c68c1517d5f1eb97417d01588d/internal/asyncinference/service_lease_test.go#L43-L54
type Completion = (proofs.EvidenceState, lifecycle.CompletionRequest)
  tag 0
  Completed = completionProven
  Indeterminate (request: 1) = completionUnknown
  Incomplete = completionDisproven

total fn rewrite
  fallback outputs (Opaque ^reasonLabelHelperUndecided) true
  match inputs
    @Launched
    inputs Launch() _ ->
      outputs (Opaque ^reasonLabelLaunchedHelper) true
    // May-alias invocation evidence can identify an ambiguous handoff beyond exact
    // completion, but it cannot establish release.
    @Argument
    inputs instruction classifier ->
      case completion classifier instruction of
        Completed() -> outputs (Release ^reasonLabelHelperRelease) true
        Indeterminate { request } -> case summaryInvokes classifier instruction request of
          true -> outputs (Release ^reasonLabelSummaryRelease) true
          false -> outputs (Opaque ^reasonLabelHelperUndecided) true
        Incomplete() -> case mayInvoke instruction of
          true -> outputs (Opaque ^reasonLabelHelperMayInvoke) true
          false -> decline
        <|> case returnsCleanup instruction of
          true -> outputs (Opaque ^reasonLabelReturnsDeferredCleanup) true
          false -> decline
        <|> outputs (NoAction ^reasonCancellationNone) false
