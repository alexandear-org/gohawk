host
  direct! = recognizeCancellationDirect
  call! = recognizeCancellationCall

total fn rewrite
  fallback outputs (Opaque ^reasonLabelHelperUndecided) true
  match inputs
    @Recognized
    inputs instruction classifier common ->
      case direct instruction classifier common of
        Decided { label } -> outputs label true
        Unrecognized() -> do
          result <- call instruction classifier common
          result
