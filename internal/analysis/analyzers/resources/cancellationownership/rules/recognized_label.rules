signature total = outputs (Opaque ^reasonLabelHelperUndecided) true

host
  direct! = recognizeCancellationDirect
  call! = recognizeCancellationCall

@Recognized
rewrite (inputs instruction classifier common) =
  case direct instruction classifier common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> do
      result <- call instruction classifier common
      result
