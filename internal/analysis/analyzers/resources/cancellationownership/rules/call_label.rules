host
  returnedCallback! = cancellationClassifier.returnedCallbackCancels
  testingCleanup! common = testingCleanupCall common classifier.cancel
  registered! instruction common = registeredCleanupCall instruction common classifier.cancel
  exactArgument! = cancellationClassifier.exactCallArgument
  captured! common = capturedCancellationArgument common classifier.cancel

total fn rewrite
  fallback outputs (Opaque ^reasonLabelHelperUndecided) true
  match inputs
    @Call
    inputs instruction classifier common ->
      case returnedCallback classifier instruction common of
        true -> outputs (Release ^reasonLabelReturnedCallback) true
        false -> decline
      <|> case testingCleanup common of
        true -> outputs (Transfer ^reasonLabelTestingCleanup) true
        false -> decline
      <|> case registered instruction common of
        true -> outputs (Opaque ^reasonLabelRegisteredCallback) true
        false -> decline
      <|> case exactArgument classifier instruction common of
        Decided { label } -> outputs label true
        Unrecognized() -> decline
      <|> case captured common of
        true -> outputs (Opaque ^reasonLabelCapturedByCallback) true
        false -> decline
      <|> outputs (NoAction ^reasonCancellationNone) false
