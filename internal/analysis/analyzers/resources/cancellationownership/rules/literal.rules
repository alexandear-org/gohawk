host
  deferredLiteralClosure?
  allowance! = cancellationClassifier.budget
  capture! = cancellationClassifier.proveDeferredCaptureWithin
  guarded! = cancellationClassifier.deferredLiteralGuard
  completes! = cancellationClassifier.deferredLiteralCompletion
  known! = deferredEvidence.Known
  proven! = deferredEvidence.Proven
  deferredLiteralCutoff!
  reasonLabelResultGuardedDefer
  reasonLabelDeferredLiteralRelease

total fn rewrite
  fallback outputs (NoAction ^reasonCancellationNone) false
  match inputs
    // A directly deferred closure is exact only after its captured cell is proven
    // stable. A result guard defers judgment to each return; unknown capture, guard
    // census or completion cannot become evidence that cancel is uncalled.
    @Literal
    inputs classifier deferred@(deferredLiteralClosure closure) ->
      do
        budget <- allowance classifier
        capture <- capture classifier closure budget
        true <- known capture
          else
            false -> outputs (Opaque ^reasonLabelDeferredClosure) true
        true <- proven capture
          else
            false -> outputs (NoAction ^reasonCancellationNone) false
        guard <- guarded classifier deferred budget
        true <- known guard
          else
            false -> outputs (Opaque ^reasonLabelDeferredClosure) true
        false <- proven guard
          else
            true -> outputs (NoAction ^reasonLabelResultGuardedDefer) true
        completion <- completes classifier deferred budget
        false <- proven completion
          else
            true -> outputs (Release ^reasonLabelDeferredLiteralRelease) true
        true <- deferredLiteralCutoff budget
          else
            false -> outputs (NoAction ^reasonCancellationNone) false
        outputs (Opaque ^reasonLabelDeferredClosure) true
