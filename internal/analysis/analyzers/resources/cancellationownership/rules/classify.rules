view Closure = *ssa.MakeClosure

host
  deferredStore! = cancellationClassifier.deferredCaptureStoreLabel
  ownerHolds! = cancellationClassifier.ownerHoldsInstruction
  recognized! = cancellationClassifier.recognizedInstruction
  ownerAvailable! = cancellationClassifier.ownerAvailable
// A standard context acquired once by the true program entry may span the
// process lifetime. Exit ends that interval without invoking cancel or joining
// workers; signal registrations and repeatable acquisitions remain outside it.
// Exact cleanup or transfer still covers this unknown.
// https://github.com/k8ssandra/k8ssandra-operator/blob/2028d352ecb495de4b6e053d99d7a77b21eb5107/main.go#L176-L205
  processReturn! = cancellationClassifier.processLifetimeReturn
  references! instruction = instructionReferencesCancellation instruction classifier.cancel
  localStorageOnly!
  localObserves! instruction = localCallOnlyObserves instruction classifier.cancel classifier.observer
  opaqueReference

total fn rewrite
  fallback outputs (Opaque ^reasonLabelOwnerUnavailable)
  match inputs
    // Creating a callback does not release or transfer cancellation. Classify the
    // defer, return, store, launch or opaque call that establishes its lifecycle.
    @ClosureCreation
    inputs Closure() _ ->
      outputs (NoAction ^reasonCancellationNone)
    @Instruction
    inputs instruction classifier ->
      case deferredStore classifier instruction of
        Decided (label: label) -> outputs label
        Unrecognized() -> decline
      <|> case ownerHolds classifier instruction of
        true -> outputs (NoAction ^reasonCancellationNone)
        false -> decline
      <|> case recognized classifier instruction of
        Decided (label: label) -> outputs label
        Unrecognized() -> decline
      <|> case ownerAvailable classifier of
        false -> outputs (Opaque ^reasonLabelOwnerUnavailable)
        true -> decline
      <|> case processReturn classifier instruction of
        true -> outputs (Opaque ^reasonLabelProcessLifetimeContext)
        false -> decline
      <|> case references instruction of
        false -> outputs (NoAction ^reasonCancellationNone)
        true -> decline
      <|> case localStorageOnly instruction of
        true -> outputs (NoAction ^reasonCancellationNone)
        false -> decline
      <|> case localObserves instruction of
        true -> outputs (NoAction ^reasonCancellationNone)
        false -> decline
      <|> outputs (Opaque (opaqueReference instruction))
