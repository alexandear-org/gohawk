signature total fallback outputs (Opaque reasonLabelHelperUndecided) true;
query returnedCallback = cancellationClassifier.returnedCallbackCancels;
query testingCleanup($common) = testingCleanupCall $common $classifier.cancel;
query registered($instruction, $common) = registeredCleanupCall $instruction $common $classifier.cancel;
query exactArgument = cancellationClassifier.exactCallArgument;
query captured($common) = capturedCancellationArgument $common $classifier.cancel;

rule Call:
  inputs $instruction $classifier $common
  => query returnedCallback $classifier $instruction $common
           select true => outputs (Release reasonLabelReturnedCallback) true
     <|> query testingCleanup $common
           select true => outputs (Transfer reasonLabelTestingCleanup) true
     <|> query registered $instruction $common
           select true => outputs (Opaque reasonLabelRegisteredCallback) true
     <|> query exactArgument $classifier $instruction $common
           select Decided label:$label => outputs $label true
     <|> query captured $common
           select true => outputs (Opaque reasonLabelCapturedByCallback) true
     <|> pure outputs (NoAction reasonCancellationNone) false;
