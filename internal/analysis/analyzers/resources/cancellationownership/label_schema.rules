type Label = cancellationLabel
  tag action
  NoAction (reason) = cancellationActionNone
  Release (reason) = cancellationActionRelease
  Transfer (reason) = cancellationActionTransfer
  Opaque (reason) = cancellationActionUnknown

type Recognized = (cancellationLabel, bool)
  tag 1
  Decided (label: 0) = true
  Unrecognized = false

host
  cancellationActionNone
  cancellationActionRelease
  cancellationActionTransfer
  cancellationActionUnknown
  reasonCancellationNone
  reasonLabelOwnerUnavailable
  reasonLabelProcessLifetimeContext
  reasonLabelReturnedCallback
  reasonLabelTestingCleanup
  reasonLabelRegisteredCallback
  reasonLabelCapturedByCallback
  reasonLabelLaunchedHelper
  reasonLabelHelperRelease
  reasonLabelSummaryRelease
  reasonLabelHelperUndecided
  reasonLabelHelperMayInvoke
  reasonLabelReturnsDeferredCleanup

view Receive = *ssa.UnOp
  op: Op
  value: X

view Deferred = *ssa.Defer

view Started = *ssa.Go

host
  receiveToken
  reasonLabelOwnDoneReceive
  reasonLabelLaunchedCancel
  reasonLabelRelease
  reasonLabelDeferredClosure
  reasonLabelReturned
