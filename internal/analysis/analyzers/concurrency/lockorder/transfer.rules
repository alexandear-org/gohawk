build emptyLockState;
signature total fallback outputs (emptyLockState);
view Effect = mutexEffect {
  operation;
};
view Deferred = *ssa.Defer {
};
const mutexRelease;
query deferRelease = lockFlowContext.deferMutexRelease;
query release = lockFlowContext.releaseMutex;
query register = lockFlowContext.registerMutexAcquisition;
query dynamicIndexedMutex;
query callerOwns = lockFlowContext.callerOwnsMutex;
query prepare = lockFlowContext.prepareMutexAcquisition;
query order = lockFlowContext.orderMutexAcquisition;
query holdMutex;

// A deferred unlock remains effective on later control-flow loop trips.
// Unique identities let the dataflow reach a fixed point without growing.
rule DeferredRelease:
  inputs $flow (Deferred) $effect:(Effect operation:mutexRelease) $state
  => do {
       $released <- query deferRelease $flow $effect $state;
       pure outputs $released;
     };

rule Release:
  inputs $flow $instruction $effect:(Effect operation:mutexRelease) $state
  => do {
       $released <- query release $flow $instruction $effect $state;
       pure outputs $released;
     };

// Registration does not execute a deferred acquisition in the function body.
// A temporary upgrade may restore its reader state only after writer unlock.
// https://github.com/refraction-networking/utls/blob/23b1dac19c06c51e278468e29ac329eec605a31f/common.go#L1100-L1119
rule DeferredAcquisition:
  inputs _ (Deferred) _ $state
  => outputs $state;

// An indexed or loop-carried receiver may denote a different runtime
// mutex each iteration. Its SSA identity cannot establish retention.
// https://github.com/caidaoli/ccLoad/blob/9ed11fe1b1dd2bfed12a32c9290354ff3cdc9b77/internal/cursorauth/sdk_runner.go#L410-L470
// https://github.com/kubernetes/kubernetes/blob/e72c2715ade37738aa5c029e8de5285cbe1c9441/pkg/kubelet/images/pullmanager/locks.go#L56-L65
// Reacquiring a borrowed caller-held lock restores caller state rather
// than creating a new obligation to release it in this helper.
// https://github.com/kubernetes/kubernetes/blob/e72c2715ade37738aa5c029e8de5285cbe1c9441/pkg/kubelet/cm/devicemanager/manager.go#L1065-L1075
rule Acquire:
  inputs $flow $instruction $effect $state
  => do {
       $values <- query register $flow $instruction $effect;
       false <- query dynamicIndexedMutex $effect.receiver
         else outputs $state;
       false <- query callerOwns $flow $effect
         else outputs $state;
       $prepared <- query prepare $flow $instruction $effect $state $values;
       true <- query order $flow $instruction $effect $prepared
         else outputs $prepared;
       $held <- query holdMutex $effect $prepared;
       pure outputs $held;
     };
