host
  emptyLockState
  lockCopyAvailable!
  copyLockLists!
  copyLockGuards!
  copyLockOrigins!

type Lists = (lockStringList, lockStringList, lockStringList, bool)
  tag 3
  CopiedLists (held: 0, readHeld: 1, deferred: 2) = true
  ListsCutoff = false

// Successors borrow until expansion. Detach every mutable collection in the
// original charge order; no cutoff can expose a partly copied successor.
type Guards = (lockGuardMap, bool)
  tag 1
  CopiedGuards (values: 0) = true
  GuardsCutoff = false

type Origins = (lockOriginMap, bool)
  tag 1
  CopiedOrigins (values: 0) = true
  OriginsCutoff = false

total fn rewrite
  fallback outputs emptyLockState() false
  match inputs
    @Copy
    inputs state budget ->
      do
        true <- lockCopyAvailable budget
          else
            false -> outputs emptyLockState() false
        CopiedLists { held, readHeld, deferred } <- copyLockLists state budget
          else
            ListsCutoff() -> outputs emptyLockState() false
        CopiedGuards { values: guards } <- copyLockGuards state budget
          else
            GuardsCutoff() -> outputs emptyLockState() false
        CopiedOrigins { values: origins } <- copyLockOrigins state budget
          else
            OriginsCutoff() -> outputs emptyLockState() false
        outputs (state with { held, readHeld, deferred, guards, origins }) true
