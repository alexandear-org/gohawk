signature total = outputs nil false

view Store = *ssa.Store
  destination: Addr

view MapUpdate = *ssa.MapUpdate
  destination: Map

view Call = *ssa.Call
  common: Call

host
  builtinArguments?

// Stores select the address directly. Containers require the caller's separate
// loaded-owner evidence before a write can be attributed to that owner.
@Store
rewrite (inputs (Store (destination: destination))) = outputs destination true

@Map
rewrite (inputs (MapUpdate (destination: destination))) = outputs destination false

// copy mutates its first argument; its source remains a permitted read.
@Builtin
rewrite (inputs (Call (common: builtinArguments ("delete" | "clear" | "copy") destination))) =
  outputs destination false
