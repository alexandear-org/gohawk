view IndexAddress = *ssa.IndexAddr
  index: Index

view Constant = *ssa.Const

view Index = *ssa.Index

view Lookup = *ssa.Lookup

view Extract = *ssa.Extract
  source: Tuple

view Field = *ssa.FieldAddr
  source: X

view Unary = *ssa.UnOp
  source: X

host
  IndexStopped
  IndexDynamic
  IndexFollow

total fn rewrite
  fallback outputs ^IndexStopped nil
  match inputs
    @ConstantAddress
    inputs (IndexAddress (index: Constant())) ->
      outputs ^IndexStopped nil
    @Dynamic
    inputs (IndexAddress() | Index() | Lookup()) ->
      outputs ^IndexDynamic nil
    @Follow
    inputs (Extract (source: source) | Field (source: source) | Unary (source: source)) ->
      outputs ^IndexFollow source
