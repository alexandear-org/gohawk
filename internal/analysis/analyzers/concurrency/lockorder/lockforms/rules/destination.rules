view Store = *ssa.Store
  destination: Addr

view MapUpdate = *ssa.MapUpdate
  destination: Map

view Call = *ssa.Call
  common: Call

host
  builtinArguments?

total fn rewrite
  fallback outputs nil false
  match inputs
    // Stores select the address directly. Containers require the caller's separate
    // loaded-owner evidence before a write can be attributed to that owner.
    @Store
    inputs (Store { destination }) ->
      outputs destination true
    @Map
    inputs (MapUpdate { destination }) ->
      outputs destination false
    // copy mutates its first argument; its source remains a permitted read.
    @Builtin
    inputs (Call { common: builtinArguments ("delete" | "clear" | "copy") destination }) ->
      outputs destination false
