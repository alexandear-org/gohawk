signature total fallback outputs false;
query cycle, arguments;
query follow = Value;
query extracted = decideExtract;
match transparent;

// Reexecuted allocations and loop phis may select a different lock each trip.
rule Allocation:
  inputs _ $value:(Allocation)
  => query cycle $value {
       true => outputs true;
       false => outputs false;
     };

rule Phi:
  inputs _ $value:(Phi)
  => query cycle $value {
       true => outputs true;
       false => outputs false;
     };

rule Extract:
  inputs $walk $value:(Extract)
  => query extracted $walk $value {
       true => outputs true;
       false => outputs false;
     };

// A queue may supply another owner on each receive. A receive outside a cycle
// is terminal false; following its channel would invent iteration dependence.
// https://github.com/encodeous/nylon/blob/c4a96c804f7aa08512721dec7994907eab100bc8/polyamide/device/channels.go#L83-L99
rule Receive:
  inputs _ $value:(Unary op:receiveToken)
  => query cycle $value {
       true => outputs true;
       false => outputs false;
     };

rule Unary:
  inputs $walk (Unary source:$source)
  => query follow $walk $source {
       true => outputs true;
       false => outputs false;
     };

// Index dependence precedes the aggregate query, sharing the same visited set.
rule Indexed:
  inputs $walk (or (IndexAddress owner:$owner index:$index) (Index owner:$owner index:$index))
  => query follow $walk $index {
       true => outputs true;
       false => query follow $walk $owner {
         true => outputs true;
         false => outputs false;
       };
     };

rule Field:
  inputs $walk (or (FieldAddress owner:$owner) (Field owner:$owner))
  => query follow $walk $owner {
       true => outputs true;
       false => outputs false;
     };

// A range index is its loop phi plus one; operand order remains significant.
rule Binary:
  inputs $walk (Binary first:$first second:$second)
  => query follow $walk $first {
       true => outputs true;
       false => query follow $walk $second {
         true => outputs true;
         false => outputs false;
       };
     };

// A lookup keyed by an iteration can select a different per-session mutex.
// A call with no variant argument does not acquire uncertainty from its name.
// https://github.com/fy0/CodeKanban/blob/745699cb67d3d34cec4793168f148eb61e43e766/service/websession/history_cleanup.go#L262-L276
rule Call:
  inputs $walk $call:(Call)
  => query arguments $walk $call {
       true => outputs true;
       false => outputs false;
     };

rule Transparent:
  inputs $walk (transparent $source)
  => query follow $walk $source {
       true => outputs true;
       false => outputs false;
     };
