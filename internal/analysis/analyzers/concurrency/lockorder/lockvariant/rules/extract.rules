signature total = outputs false

host
  cycle!
  follow! = Value

@Iterated
rewrite (inputs _ (Extract (tuple: next@(Next())))) =
  case cycle next of
    true -> outputs true
    false -> outputs false

// Selected-case index and receive-ok are metadata. Only received payloads may
// inherit the choice's cycle dependence; no extra tuple walk is charged here.
@Payload
rewrite (inputs _ (Extract (tuple: choice@(Select()), index: index)))
  | index >= 2
  =
  case cycle choice of
    true -> outputs true
    false -> outputs false

@Metadata
rewrite (inputs _ (Extract (tuple: Select()))) = outputs false

@Other
rewrite (inputs walk (Extract (tuple: tuple))) =
  case follow walk tuple of
    true -> outputs true
    false -> outputs false
