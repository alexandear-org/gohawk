type Proof = Proof
  tag State
  Accepted (reason: Reason) = disprovenState
  Unknown (reason: Reason) = unknownState
  Reported (reason: Reason) = provenState

type Step = Step
  tag Stop
  Continue (proof: Proof) = false
  Stop (proof: Proof) = true

type Writer = WriterEvidence
  tag State
  WriterFound = provenState
  WriterAbsent = disprovenState
  WriterUnavailable = unknownState

host
  LockStateBudgetExhausted
