view Operation = concurrencyfacts.Operation
  kind: Kind
  resource: Resource

view Resource = concurrencyfacts.Reference
  value: Value
  indirect: Indirect

host
  projected
  held! = lockRegion.holds
  lockEffectIgnore
  lockEffectUnknown
  lockEffectAcquire
  lockEffectRelease
  lock
  unlock
  readLock
  readUnlock
  condWait

total fn rewrite
  fallback outputs ^lockEffectIgnore nil
  match inputs
    // An unresolved projection makes even an otherwise ignored effect uncertain.
    @Projected
    inputs operation _
      when projected operation ->
      outputs ^lockEffectUnknown nil
    @Indirect
    inputs (Operation (kind: (^lock | ^unlock), resource: Resource (indirect: true))) _ ->
      outputs ^lockEffectUnknown nil
    @Absent
    inputs (Operation (kind: (^lock | ^unlock), resource: Resource (value: nil))) _ ->
      outputs ^lockEffectUnknown nil
    @Acquire
    inputs (Operation (kind: ^lock, resource: Resource (value: value))) _ ->
      outputs ^lockEffectAcquire value
    @Release
    inputs (Operation (kind: ^unlock, resource: Resource (value: value))) region ->
      case held region value of
        true -> outputs ^lockEffectRelease value
        false -> outputs ^lockEffectUnknown nil
    // Wait temporarily releases a Locker. Read locking is not an exclusive guard;
    // this query declines both instead of claiming the write has no guard.
    @Unsupported
    inputs (Operation (kind: (^condWait | ^readLock | ^readUnlock))) _ ->
      outputs ^lockEffectUnknown nil
