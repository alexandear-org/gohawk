signature total = outputs ^lockEffectIgnore nil

view Operation = concurrencyfacts.Operation
  kind: Kind
  resource: Resource

view Resource = concurrencyfacts.Reference
  value: Value
  indirect: Indirect

host
  projected
  held! = lockRegion.holds
  lockEffectIgnore
  lockEffectUnknown
  lockEffectAcquire
  lockEffectRelease
  lock
  unlock
  readLock
  readUnlock
  condWait

// An unresolved projection makes even an otherwise ignored effect uncertain.
@Projected
rewrite (inputs operation _)
  | projected operation
  =
  outputs ^lockEffectUnknown nil

@Indirect
rewrite (inputs (Operation (kind: (^lock | ^unlock), resource: Resource (indirect: true))) _) =
  outputs ^lockEffectUnknown nil

@Absent
rewrite (inputs (Operation (kind: (^lock | ^unlock), resource: Resource (value: nil))) _) =
  outputs ^lockEffectUnknown nil

@Acquire
rewrite (inputs (Operation (kind: ^lock, resource: Resource (value: value))) _) =
  outputs ^lockEffectAcquire value

@Release
rewrite (inputs (Operation (kind: ^unlock, resource: Resource (value: value))) region) =
  case held region value of
    true -> outputs ^lockEffectRelease value
    false -> outputs ^lockEffectUnknown nil

// Wait temporarily releases a Locker. Read locking is not an exclusive guard;
// this query declines both instead of claiming the write has no guard.
@Unsupported
rewrite (inputs (Operation (kind: (^condWait | ^readLock | ^readUnlock))) _) =
  outputs ^lockEffectUnknown nil
