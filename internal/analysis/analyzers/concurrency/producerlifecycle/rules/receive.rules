signature total = outputs (Known (count: 0, reason: ^reasonNone))

view Unary = *ssa.UnOp
  op: Op
  channel: X

view Select = *ssa.Select

host
  callInstruction?
  helper! = helperReceives
  alias! = heapmodel.MayAlias
  selected! = selectedReceives
  receiveToken
  reasonNone

// Helper calls keep their count, uncertainty and reason intact. In particular,
// an asynchronous or exhausted helper cannot become a missing receive.
@Helper
rewrite (inputs (callInstruction call) channel origin engine budget) =
  do
    proof <- helper call channel origin engine budget
    case proof of
      Known() -> outputs proof
      Unknown() -> outputs proof

@Receive
rewrite (inputs (Unary (op: ^receiveToken, channel: received)) channel _ _ _) =
  case alias received channel of
    true -> outputs (Known (count: 1, reason: ^reasonNone))
    false -> outputs (Known (count: 0, reason: ^reasonNone))

// Select states retain the original may-count policy. The query only scans
// this instruction's states; it does not infer an exact protocol or loop count.
@Select
rewrite (inputs select@(Select()) channel _ _ _) =
  do
    proof <- selected select channel
    case proof of
      Known() -> outputs proof
      Unknown() -> outputs proof
