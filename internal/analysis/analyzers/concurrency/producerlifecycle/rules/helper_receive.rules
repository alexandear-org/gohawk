host
  producerOrigin
  producerBuiltin
  receiverSummary!
  receiverExhausted!
  receiverComplete!
  receiverLaunched!
  nonReceivingUses!
  opaqueReceives!
  summaryReceives!
  proven! = producerProof.Proven
  opaqueReceiver
  reasonProducerLaunch
  reasonBuiltinNotReceive
  reasonReceiverBudgetExhausted
  reasonWorkerChannelUsesComplete
  reasonReceiverHelperUnknown

total fn rewrite
  fallback outputs (Unknown (count: 0, reason: ^reasonReceiverHelperUnknown))
  match inputs
    @Origin
    inputs call _ origin _ _
      when producerOrigin call origin ->
      outputs (Known (count: 0, reason: ^reasonProducerLaunch))
    @Builtin
    inputs call _ _ _ _
      when producerBuiltin call ->
      outputs (Known (count: 0, reason: ^reasonBuiltinNotReceive))
    @Helper
    inputs call channel _ engine budget ->
      do
        summary <- receiverSummary engine call budget
        false <- receiverExhausted budget
          else
            true -> outputs (Unknown (count: 0, reason: ^reasonReceiverBudgetExhausted))
        true <- receiverComplete summary
          else
            false -> do
              true <- receiverLaunched call
                else
                  false -> decline
              uses <- nonReceivingUses call channel budget
              true <- proven uses
                else
                  false -> decline
              outputs (Known (count: 0, reason: ^reasonWorkerChannelUsesComplete))
            <|> do
              false <- receiverExhausted budget
                else
                  true -> outputs (Unknown (count: 0, reason: ^reasonReceiverBudgetExhausted))
              uncertain <- opaqueReceives call channel budget
              false <- receiverExhausted budget
                else
                  true -> outputs (Unknown (count: 0, reason: ^reasonReceiverBudgetExhausted))
              outputs (opaqueReceiver uncertain)
            <|> outputs (Unknown (count: 0, reason: ^reasonReceiverHelperUnknown))
        launched <- receiverLaunched call
        answer <- summaryReceives summary channel launched budget
        outputs answer
