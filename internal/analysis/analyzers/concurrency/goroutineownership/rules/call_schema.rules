type Label = helperCallProof
  tag action
  NoAction (reason) = actionNone
  Join (reason) = actionJoin
  Transfer (reason) = actionTransfer
  Opaque (reason) = actionUnknown

type Recognized = (helperCallProof, bool)
  tag 1
  Decided (label: 0) = true
  Unrecognized = false

host
  actionNone
  actionJoin
  actionTransfer
  actionUnknown
  reasonNone
  reasonLabelCallUnavailable
