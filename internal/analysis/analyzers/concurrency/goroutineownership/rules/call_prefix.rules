signature total = outputs (Opaque ^reasonLabelCallUnavailable) true

view Launch = *ssa.Go

view Common = *ssa.CallCommon
  value: Value

view Builtin = *ssa.Builtin

host
  name = callBuiltin.Name
  opaque! = spawnAnalysis.opaqueCallAction
  arguments! = spawnAnalysis.anyArgumentConsumes
  direct! = spawnAnalysis.directJoinAction
  reasonLabelLaunchedHelper
  reasonLabelAppended

@Missing
rewrite (inputs (common: nil)) = outputs (NoAction ^reasonNone) true

// A launched observer runs independently of the caller. Handle it before
// receiver, summary and library contracts that describe synchronous calls.
@Launched
rewrite (inputs (analysis: analysis, instruction: Launch(), common: common)) =
  do
    label <- opaque analysis common ^reasonLabelLaunchedHelper
    case label of
      NoAction() -> outputs label true
      Join() -> outputs label true
      Transfer() -> outputs label true
      Opaque() -> outputs label true

// append retains its arguments in a slice the caller keeps; the other
// builtins only observe a channel or its capacity.
@Appended
rewrite (inputs (analysis: analysis, common: common@(Common (value: builtin@(Builtin())))))
  | let name = name builtin
  , name == "append"
  =
  case arguments analysis common of
    true -> outputs (Opaque ^reasonLabelAppended) true
    false -> outputs (NoAction ^reasonNone) true

@OtherBuiltin
rewrite (inputs (common: Common (value: Builtin()))) = outputs (NoAction ^reasonNone) true

@Direct
rewrite (inputs (analysis: analysis, common: common)) =
  case direct analysis common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> decline
  <|> outputs (NoAction ^reasonNone) false
