signature total = outputs ^Work

host
  Work
  Passive
  Deferred
  loadToken
  closes

// This policy is deliberately broader than terminal completion: an opaque
// call's nonblocking tail may load a captured cell or close a completion signal.
// Other unary operations, named calls, sends, receives and launches remain work.
@Passive
rewrite (inputs (Return() | Jump() | Debug() | Unary (op: ^loadToken))) = outputs ^Passive

@Close
rewrite (inputs call@(Call()))
  | closes call
  =
  outputs ^Passive

@Deferred
rewrite (inputs Defers()) = outputs ^Deferred
