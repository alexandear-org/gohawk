host
  Work
  Passive
  Deferred
  loadToken
  closes

total fn rewrite
  fallback outputs ^Work
  match inputs
    // This policy is deliberately broader than terminal completion: an opaque
    // call's nonblocking tail may load a captured cell or close a completion signal.
    // Other unary operations, named calls, sends, receives and launches remain work.
    @Passive
    inputs (Return() | Jump() | Debug() | Unary (op: ^loadToken)) ->
      outputs ^Passive
    @Close
    inputs call@(Call())
      when closes call ->
      outputs ^Passive
    @Deferred
    inputs Defers() ->
      outputs ^Deferred
