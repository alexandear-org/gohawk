signature total = outputs ^edgeNone

host
  selected! = EdgeQueries.Selected
  drain! = EdgeQueries.Drain
  possible! = EdgeQueries.Possible
  ownership! = EdgeQueries.Ownership
  edgeNone
  edgeExact
  edgeUnknown

// Exact selected receives precede counted drains. A drain's unknown answer is
// terminal too; later possible receive/context evidence cannot replace it.
type DrainEvidence = (ssapath.ObligationAction, bool)
  tag 1
  Drained (action: 0) = true
  Unproven = false

@Edge
rewrite (inputs queries) =
  case selected queries of
    true -> outputs ^edgeExact
    false -> decline
  <|> case drain queries of
    Drained (action: action) -> outputs action
    Unproven() -> decline
  <|> case possible queries of
    true -> outputs ^edgeUnknown
    false -> decline
  <|> case ownership queries of
    true -> outputs ^edgeUnknown
    false -> decline
  <|> outputs ^edgeNone
