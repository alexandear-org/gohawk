signature total fallback outputs (emptyProof) false;
query stop = CallerLifetimeQueries.Stop;
query context = CallerLifetimeQueries.Context;
query canceled = CallerLifetimeQueries.Canceled;
query receiver = CallerLifetimeQueries.Receiver;
query cutoff = CallerLifetimeQueries.Cutoff;
const StopLifecycle, ContextLifecycle, LocallyCanceledContext, ReceiverContext;
query available = LifetimeObservation.Available;
query matched = LifetimeObservation.Matched;

// Cutoff precedes every witness, including a positive partial search. Each
// completed false query alone permits the next strategy under the same budget.
rule Caller:
  inputs $queries
  => do {
       $stop <- query stop $queries;
       true <- query available $stop
         else do {
                $proof <- query cutoff $queries;
                pure outputs $proof true;
              };
       false <- query matched $stop
         else outputs (Unknown reason:StopLifecycle) true;
       $context <- query context $queries;
       true <- query available $context
         else do {
                $proof <- query cutoff $queries;
                pure outputs $proof true;
              };
       false <- query matched $context
         else outputs (Unknown reason:ContextLifecycle) true;
       $canceled <- query canceled $queries;
       true <- query available $canceled
         else do {
                $proof <- query cutoff $queries;
                pure outputs $proof true;
              };
       false <- query matched $canceled
         else outputs (Unknown reason:LocallyCanceledContext) true;
       $receiver <- query receiver $queries;
       true <- query available $receiver
         else do {
                $proof <- query cutoff $queries;
                pure outputs $proof true;
              };
       false <- query matched $receiver
         else outputs (Unknown reason:ReceiverContext) true;
       pure outputs (emptyProof) false;
     };
