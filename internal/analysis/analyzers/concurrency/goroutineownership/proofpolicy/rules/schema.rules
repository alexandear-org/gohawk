type Decision = Proof
  tag Outcome
  Unknown (reason: Reason)
  Honored (reason: Reason)
  Violated (reason: Reason, witness: Witness)
  Transferred (reason: Reason)

type Optional = (Proof, bool)
  tag 1
  Decided (proof: 0) = true
  Undecided = false

view Discovery = Discovery
  exhausted: Exhausted
  obligation: Obligation
  early: EarlyDone

type RelayEvidence = Relay
  tag Kind
  RelayMissing = RelayAbsent
  RelayFound = RelayRelated
  RelayCutoff (budget: Budget) = RelayInterrupted

type SignalEvidence = Census
  tag Kind
  Observed = CensusObserved
  Unobserved = CensusUnobserved
  Unavailable = CensusUnavailable
  CensusCutoff (budget: Budget) = CensusInterrupted

host
  emptyProof
  lifecycle! = ProofQueries.Lifecycle
  fallback! = ProofQueries.Fallback
  relay! = LifecycleQueries.Relay
  relayCutoff! = LifecycleQueries.RelayCutoff
  handle! = LifecycleQueries.CompletionHandle
  caller! = LifecycleQueries.CallerLifetime
  synctest! = LifecycleQueries.Synctest
  dominating! = ProofQueries.Dominating
  workers! = ProofQueries.Workers
  flow! = ProofQueries.Flow
  honored! = ProofQueries.Honored
  guarded! = ProofQueries.Guarded
  uncertain! = ProofQueries.Uncertain
  flagGuarded! = FallbackQueries.FlagGuarded
  counted! = FallbackQueries.Counted
  shared! = FallbackQueries.SharedStorage
  buffered! = FallbackQueries.Buffered
  census! = FallbackQueries.Census
  censusCutoff! = FallbackQueries.CensusCutoff
  entry! = FallbackQueries.ProgramEntry
  DiscoveryBudgetExhausted
  DoneBeforeCompletion
  NoObligation
  WorkerConsumesSignal
  JoinProven
  GuardedLocalJoin
  OpaqueTransfer
  FlagGuardedJoin
  LoopJoinUnproven
  SharedStorageSignal
  BufferedSignal
  UnobservedSignal
  SignalCensusUnavailable
  ProcessExitStopsWorker
  UnownedReturn
  RelayDependency
  SynctestBubbleOwner
