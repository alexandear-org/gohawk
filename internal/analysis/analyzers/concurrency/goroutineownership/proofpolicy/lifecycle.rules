signature total fallback outputs (emptyProof) false;

// Completion-handle ownership is independent of stop/context inputs. Factory
// opacity precedes an external transfer claim; a lifetime bound is not a join.
rule Lifecycle:
  inputs $queries
  => do {
       RelayMissing <- query relay $queries
         else {
           RelayFound => outputs (Unknown reason:RelayDependency) true;
           RelayCutoff budget:$budget => do {
             $proof <- query relayCutoff $queries $budget;
             pure outputs $proof true;
           };
         };
       Undecided <- query handle $queries
         else {
           Decided proof:$proof => outputs $proof true;
         };
       Undecided <- query caller $queries
         else {
           Decided proof:$proof => outputs $proof true;
         };
       true <- query synctest $queries
         else outputs (emptyProof) false;
       pure outputs (Honored reason:SynctestBubbleOwner) true;
     };
