host
  sameValue
  stored! = storedCarries
  source! = Matches

total fn rewrite
  fallback outputs false
  match inputs
    @Store
    inputs walk (Store { address, value }) owner target
      when sameValue address owner ->
      case source walk value target of
        true -> outputs true
        false -> outputs false
    // Each selected address has its own referrers. The surrounding walk retains
    // sibling selection and marking before these recursive use queries.
    @Selected
    inputs walk ((FieldAddress() | IndexAddress()) as value) _ target ->
      case stored walk value target of
        true -> outputs true
        false -> outputs false
