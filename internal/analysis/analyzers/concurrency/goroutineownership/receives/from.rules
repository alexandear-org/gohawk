signature total = outputs false

host
  channel! = matchChannel
  selected! = selectReceives
  channelRange

@Receive
rewrite (inputs (Unary (op: ^receiveToken, channel: channel)) matches _) =
  case channel matches channel of
    true -> outputs true
    false -> outputs false

// Select enumeration spends each existing arm visit before invoking a channel
// predicate. Other arms do not borrow a matching receive's identity.
@Select
rewrite (inputs choice@(Select()) matches budget) =
  case selected choice matches budget of
    true -> outputs true
    false -> outputs false

@Range
rewrite (inputs (Range (channel: channel)) matches _)
  | channelRange channel
  =
  case channel matches channel of
    true -> outputs true
    false -> outputs false
