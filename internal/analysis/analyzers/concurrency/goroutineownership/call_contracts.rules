signature total = outputs (Opaque ^reasonLabelCallUnavailable) true

host
  retained! = spawnAnalysis.retainedOwnerLabel
  pipe! = spawnAnalysis.pipePeerAction
  summary! = spawnAnalysis.summarizedJoin
  bookkeeping! = spawnAnalysis.waitGroupBookkeeping
  cleanup! = spawnAnalysis.testingCleanupAction
// gomock.Return publishes its configured results, but broad argument
// containment does not prove the exact stream is among those results.
// https://github.com/uber-go/mock/blob/539d81c0f42174d17e8f91abcb869bed37605a15/gomock/call.go#L185-L205
  mockContract! = ssacall.HasLibraryContract
  arguments! = spawnAnalysis.anyArgumentConsumes
  goMockReturn
  reasonLabelGoMockReturn

@Missing
rewrite (inputs (common: nil)) = outputs (NoAction ^reasonNone) true

// Each answer commits, including a recognized none label. Partial evidence
// retains its original precedence before summary, bookkeeping and callbacks.
@Contract
rewrite (inputs analysis instruction common) =
  case retained analysis instruction common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> decline
  <|> case pipe analysis instruction common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> decline
  <|> case summary analysis instruction of
    Decided (label: label) -> outputs label true
    Unrecognized() -> decline
  <|> case bookkeeping analysis common of
    true -> outputs (NoAction ^reasonNone) true
    false -> decline
  <|> case cleanup analysis common of
    Decided (label: label) -> outputs label true
    Unrecognized() -> decline
  <|> case mockContract common ^goMockReturn of
    true -> case arguments analysis common of
      true -> outputs (Opaque ^reasonLabelGoMockReturn) true
      false -> outputs (NoAction ^reasonNone) false
    false -> decline
  <|> outputs (NoAction ^reasonNone) false
