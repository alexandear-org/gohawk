signature total = outputs false false

host
  resultAlwaysTrue
  resultAlwaysFalse
  comparisonEqual
  comparisonNotEqual

view Comparison = *ssa.BinOp
  left: X
  right: Y
  op: Op

view Constant = *ssa.Const

host
  truth = comparisonTruth
  equality! = decideResultComparison

type Equality = (bool, bool)
  tag 1
  Known (equal: 0) = true
  Unknown (equal: 0) = false

@True
rewrite (inputs _ _ ^resultAlwaysTrue _ _) = outputs true true

@False
rewrite (inputs _ _ ^resultAlwaysFalse _ _) = outputs false true

// A literal on the left is swapped first, including when both sides are
// constants. Do not request a summary for unsupported operators or operands.
@LiteralLeft
rewrite (inputs provider (Comparison (left: literal@(Constant()), right: left, op: op@(^comparisonEqual | ^comparisonNotEqual))) _ block budget) =
  case equality provider left literal block budget of
    Known (equal: equal) -> outputs (truth equal op) true
    Unknown (equal: equal) -> outputs (truth equal op) false

// Preserve the equality payload even when unknown: the caller still requires
// known before pruning a successor, and this keeps the native result contract.
@LiteralRight
rewrite (inputs provider (Comparison (left: left, right: literal@(Constant()), op: op@(^comparisonEqual | ^comparisonNotEqual))) _ block budget) =
  case equality provider left literal block budget of
    Known (equal: equal) -> outputs (truth equal op) true
    Unknown (equal: equal) -> outputs (truth equal op) false
