host
  literal! = Provider.literalEquality
  paired! = Provider.pairedNilness
  Nil = comparisonNil

// Paired-result evidence is meaningful only for a nil literal and only after
// the unconditional summary could not decide equality. Keep the two requests
// sequential and in the same allowance; no result is queried speculatively.
type Equality = (bool, bool)
  tag 1
  Known (equal: 0) = true
  Unknown (equal: 0) = false

total fn rewrite
  fallback outputs false false
  match inputs
    @NilComparison
    inputs provider value literal block budget
      when Nil literal ->
      do
        answer <- literal provider value literal budget
        case answer of
          Known() -> answer
          Unknown() -> do
            paired <- paired provider value block budget
            paired
    @OtherComparison
    inputs provider value literal _ budget ->
      do
        answer <- literal provider value literal budget
        answer
