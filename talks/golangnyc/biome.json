{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**/*.json",
      "**/*.mjs",
      "**/*.css",
      "!node_modules",
      "!dist",
      "!pnpm-lock.yaml",
      "!public"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
